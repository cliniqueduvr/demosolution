---
import siteSettings from '../data/site-settings.json';
import servicePagesFr from '../data/service-pages.json';
import servicePagesEn from '../data/service-pages-en.json';

export interface Props {
  lang?: 'fr' | 'en';
}

const { lang = 'fr' } = Astro.props as Props;
const isEnglish = lang === 'en';
const currentPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const frToEnServiceSlug = new Map(servicePagesFr.items.map((service) => [service.slug, service.alternateSlug]));
const enToFrServiceSlug = new Map(servicePagesEn.items.map((service) => [service.slug, service.alternateSlug]));

function getAlternatePath(pathname: string, targetLang: 'fr' | 'en') {
  const normalizedPath = pathname.endsWith('/') ? pathname : `${pathname}/`;

  const staticFrToEn: Record<string, string> = {
    '/': '/en/',
    '/about/': '/en/about/',
    '/choisir-service/': '/en/choose-service/',
    '/contact/': '/en/contact/',
    '/soumission/': '/en/contact/',
    '/amiante/': '/en/services/vermiculite-removal/',
    '/moisissure/': '/en/services/mould-removal/',
    '/inspection-qualite-air/': '/en/services/sampling/',
    '/gatineau/': '/en/services/',
    '/outaouais/': '/en/services/',
    '/ottawa/': '/en/services/',
    '/ville-de-quebec/': '/en/services/',
    '/faq/': '/en/faq/',
    '/plan-du-site/': '/en/site-map/',
    '/privacy/': '/en/privacy/',
    '/tarifs-moisissure/': '/en/mould-pricing/',
    '/tarifs-vermiculite/': '/en/vermiculite-pricing/',
    '/merci/': '/en/thank-you/',
    '/merci.html/': '/en/thank-you.html/',
    '/realisations/': '/en/realisations/',
    '/services/': '/en/services/'
  };

  const staticEnToFr: Record<string, string> = {
    '/en/': '/',
    '/en/about/': '/about/',
    '/en/choose-service/': '/choisir-service/',
    '/en/contact/': '/contact/',
    '/en/faq/': '/faq/',
    '/en/site-map/': '/plan-du-site/',
    '/en/privacy/': '/privacy/',
    '/en/mould-pricing/': '/tarifs-moisissure/',
    '/en/vermiculite-pricing/': '/tarifs-vermiculite/',
    '/en/thank-you/': '/merci/',
    '/en/thank-you.html/': '/merci.html/',
    '/en/realisations/': '/realisations/',
    '/en/services/': '/services/'
  };

  if (targetLang === 'en') {
    if (staticFrToEn[normalizedPath]) return staticFrToEn[normalizedPath];
    if (normalizedPath.startsWith('/services/')) {
      const slug = normalizedPath.replace('/services/', '').replaceAll('/', '');
      return `/en/services/${frToEnServiceSlug.get(slug) ?? slug}/`;
    }
    return normalizedPath.startsWith('/en/') ? normalizedPath : `/en${normalizedPath}`;
  }

  if (staticEnToFr[normalizedPath]) return staticEnToFr[normalizedPath];
  if (normalizedPath.startsWith('/en/services/')) {
    const slug = normalizedPath.replace('/en/services/', '').replaceAll('/', '');
    return `/services/${enToFrServiceSlug.get(slug) ?? slug}/`;
  }
  return normalizedPath.startsWith('/en/') ? normalizedPath.replace(/^\/en/, '') || '/' : normalizedPath;
}

const homeHref = isEnglish ? '/en/' : '/';
const frHref = getAlternatePath(currentPath, 'fr');
const enHref = getAlternatePath(currentPath, 'en');
const quoteHref = isEnglish ? '/en/contact/' : '/soumission/';
const smsHref = `sms:${siteSettings.phone.href}`;
const facebookUrl = siteSettings.facebookUrl?.trim();
const tiktokUrl = siteSettings.tiktokUrl?.trim();
const isActivePath = (href: string) => {
  if (href === '/') return currentPath === '/';
  if (href === '/en/') return currentPath === '/en/';
  return currentPath === href || currentPath.startsWith(href);
};
const serviceMenuItems = (isEnglish ? servicePagesEn.items : servicePagesFr.items)
  .filter((service) =>
    isEnglish
      ? ['decontamination', 'mould-removal', 'selective-demolition', 'vermiculite-removal', 'sampling'].includes(service.slug)
      : true
  )
  .map((service) => ({
    label: service.navLabel,
    href: isEnglish ? `/en/services/${service.slug}/` : `/services/${service.slug}/`,
    active: currentPath === (isEnglish ? `/en/services/${service.slug}/` : `/services/${service.slug}/`)
  }));
const resourceMenuItems = isEnglish
  ? [
      { label: 'Sampling', href: '/en/services/sampling/', active: currentPath === '/en/services/sampling/' },
      { label: 'Mould Remediation', href: '/en/services/mould-removal/', active: currentPath === '/en/services/mould-removal/' },
      { label: 'Vermiculite Removal', href: '/en/services/vermiculite-removal/', active: currentPath === '/en/services/vermiculite-removal/' },
      { label: 'FAQ', href: '/en/faq/', active: currentPath === '/en/faq/' }
    ]
  : [
      { label: 'Amiante', href: '/amiante/', active: currentPath === '/amiante/' },
      { label: 'Moisissure', href: '/moisissure/', active: currentPath === '/moisissure/' },
      { label: "Qualité de l’air", href: '/inspection-qualite-air/', active: currentPath === '/inspection-qualite-air/' },
      { label: 'FAQ', href: '/faq/', active: currentPath === '/faq/' }
    ];
const navItems = isEnglish
  ? [
      { label: 'Home', href: '/en/' },
      { label: 'About', href: '/en/about/' },
      { label: 'Services', href: '/en/services/' },
      { label: 'Resources', href: '/en/faq/' },
      { label: 'Quote', href: '/en/contact/' },
    ]
  : [
      { label: 'Accueil', href: '/' },
      { label: 'À Propos', href: '/about/' },
      { label: 'Services', href: '/services/' },
      { label: 'Ressources', href: '/inspection-qualite-air/' },
      { label: 'Soumission', href: '/soumission/' },
    ];
---

<header class="header">
  <div class="topbar">
    <div class="container topbar-inner">
      <div class="topbar-left">
        <a href={`tel:${siteSettings.phone.href}`} class="topbar-phone">{siteSettings.phone.display}</a>
        <a href={smsHref} class="sms-link">{isEnglish ? 'Text us' : 'Message texte'}</a>
        <a href={quoteHref} class="square-link">{isEnglish ? 'Request a quote' : 'Soumission'}</a>
      </div>
      <div class="topbar-right">
        <div class="topbar-credentials">
          <strong>RBQ: 5824-9764-01</strong>
          <small>Assurance pollution</small>
        </div>
        <div class="lang-switch">
          <a href={frHref} class:list={['lang-pill', !isEnglish && 'active']}>FR</a>
          <a href={enHref} class:list={['lang-pill', isEnglish && 'active']}>EN</a>
        </div>
        {facebookUrl && (
          <a href={facebookUrl} target="_blank" rel="noopener" title="Facebook">
            <i class="fab fa-facebook"></i>
          </a>
        )}
        {tiktokUrl && (
          <a href={tiktokUrl} target="_blank" rel="noopener" title="TikTok" aria-label="TikTok">
            <i class="fab fa-tiktok"></i>
          </a>
        )}
      </div>
    </div>
  </div>

  <nav class="navbar">
    <div class="container navbar-inner">
      <a href={homeHref} class="logo">
        <img src={siteSettings.brandImage} alt="Demo Solution" />
      </a>
      <div class="nav-panel" id="site-nav" data-nav-panel>
        <ul class="nav-menu">
          {navItems.map(item => (
            item.href === (isEnglish ? '/en/services/' : '/services/') || item.label === (isEnglish ? 'Resources' : 'Ressources')
              ? (
                <li class="nav-item-with-children">
                  <div class="nav-link-row">
                    <a
                      href={item.href}
                      class:list={[isActivePath(item.href) && 'active']}
                      aria-current={isActivePath(item.href) ? 'page' : undefined}
                    >
                      {item.label}
                    </a>
                    <button
                      class="submenu-toggle"
                      type="button"
                      aria-label={
                        item.href === (isEnglish ? '/en/services/' : '/services/')
                          ? (isEnglish ? 'Show services' : 'Afficher les services')
                          : (isEnglish ? 'Show resources' : 'Afficher les ressources')
                      }
                      aria-expanded="false"
                      data-submenu-toggle
                    >
                      <i class="fas fa-chevron-down" aria-hidden="true"></i>
                    </button>
                  </div>
                  <ul class="submenu" data-submenu>
                    {(item.href === (isEnglish ? '/en/services/' : '/services/') ? serviceMenuItems : resourceMenuItems).map((serviceItem) => (
                      <li>
                        <a
                          href={serviceItem.href}
                          class:list={[serviceItem.active && 'active']}
                          aria-current={serviceItem.active ? 'page' : undefined}
                        >
                          {serviceItem.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </li>
              )
              : (
                <li>
                  <a
                    href={item.href}
                    class:list={[isActivePath(item.href) && 'active']}
                    aria-current={isActivePath(item.href) ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              )
          ))}
        </ul>
        <div class="mobile-nav-actions">
          <a href={smsHref} class="mobile-nav-action mobile-nav-action--secondary">
            <i class="fas fa-comment-dots" aria-hidden="true"></i>
            <span>{isEnglish ? 'Text us' : 'Message texte'}</span>
          </a>
          <a href={quoteHref} class="mobile-nav-action mobile-nav-action--primary">
            <i class="fas fa-calendar-check" aria-hidden="true"></i>
            <span>{isEnglish ? 'Request a quote' : 'Soumission'}</span>
          </a>
        </div>
        <div class="mobile-lang-switch">
          <span>{isEnglish ? 'Language' : 'Langue'}</span>
          <div class="lang-switch">
            <a href={frHref} class:list={['lang-pill', !isEnglish && 'active']}>FR</a>
            <a href={enHref} class:list={['lang-pill', isEnglish && 'active']}>EN</a>
          </div>
        </div>
      </div>
      <button class="hamburger" type="button" aria-label={isEnglish ? 'Open menu' : 'Ouvrir le menu'} aria-expanded="false" aria-controls="site-nav" data-nav-toggle>
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </nav>
</header>

<script is:inline>
  (() => {
    const header = document.querySelector('.header');
    if (!header) return;

    const toggle = header.querySelector('[data-nav-toggle]');
    const panel = header.querySelector('[data-nav-panel]');
    if (!(toggle instanceof HTMLButtonElement) || !(panel instanceof HTMLElement)) return;
    const submenuToggles = Array.from(panel.querySelectorAll('[data-submenu-toggle]'));

    const closeSubmenus = () => {
      submenuToggles.forEach((submenuToggle) => {
        if (!(submenuToggle instanceof HTMLButtonElement)) return;
        submenuToggle.setAttribute('aria-expanded', 'false');
        submenuToggle.closest('.nav-item-with-children')?.removeAttribute('data-submenu-open');
      });
    };

    const closeMenu = () => {
      closeSubmenus();
      header.removeAttribute('data-menu-open');
      toggle.setAttribute('aria-expanded', 'false');
    };

    toggle.addEventListener('click', () => {
      const isOpen = header.getAttribute('data-menu-open') === 'true';
      if (isOpen) {
        closeMenu();
        return;
      }

      header.setAttribute('data-menu-open', 'true');
      toggle.setAttribute('aria-expanded', 'true');
    });

    submenuToggles.forEach((submenuToggle) => {
      if (!(submenuToggle instanceof HTMLButtonElement)) return;

      submenuToggle.addEventListener('click', (event) => {
        event.preventDefault();
        const navItem = submenuToggle.closest('.nav-item-with-children');
        if (!(navItem instanceof HTMLElement)) return;

        const isOpen = navItem.getAttribute('data-submenu-open') === 'true';
        closeSubmenus();

        if (isOpen) return;

        navItem.setAttribute('data-submenu-open', 'true');
        submenuToggle.setAttribute('aria-expanded', 'true');
      });
    });

    panel.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', closeMenu);
    });

    window.addEventListener('resize', () => {
      if (window.innerWidth > 768) closeMenu();
    });
  })();
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: white;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  }

  .topbar {
    background: var(--brand-navy);
    color: white;
    padding: 0.75rem 0;
    font-size: 0.9rem;
  }

  .topbar-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .topbar-left {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
  }

  .topbar-left a, .topbar-left span {
    color: white;
  }

  .topbar-phone {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: 0.02em;
  }

  .sms-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    background: var(--brand-green);
    border: 2px solid var(--brand-green);
    color: white !important;
    font-weight: 700;
  }

  .sms-link:hover {
    text-decoration: none;
    background: var(--brand-green-dark);
    border-color: var(--brand-green-dark);
  }

  .square-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    background: var(--brand-gold);
    color: var(--brand-navy-dark) !important;
    border: 2px solid var(--brand-gold);
    font-weight: 700;
  }

  .square-link:hover {
    text-decoration: none;
    background: #e1c317;
    border-color: #e1c317;
  }

  .topbar-right a {
    color: white;
    font-size: 1.2rem;
    margin-left: 1rem;
  }

  .topbar-right {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .topbar-credentials {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    line-height: 1.05;
  }

  .topbar-credentials strong {
    color: white;
    font-size: 0.88rem;
    letter-spacing: 0.02em;
  }

  .topbar-credentials small {
    margin-top: 0.16rem;
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.68rem;
  }

  .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .lang-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.3rem;
    padding: 0.25rem 0.55rem;
    border-radius: 999px;
    border: 1px solid rgba(255,255,255,0.35);
    font-size: 0.8rem !important;
    font-weight: 700;
    margin-left: 0 !important;
  }

  .lang-pill.active {
    background: var(--brand-gold);
    color: var(--brand-navy-dark) !important;
    border-color: var(--brand-gold);
  }

  .navbar {
    background: white;
    padding: 1rem 0;
    position: relative;
  }

  .navbar-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .logo {
    text-decoration: none;
    display: flex;
    align-items: center;
  }

  .logo img {
    height: 64px;
    width: auto;
    display: block;
  }

  .nav-panel {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .nav-menu {
    display: flex;
    list-style: none;
    gap: 2rem;
  }

  .nav-menu > li {
    position: relative;
  }

  .nav-item-with-children::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    height: 0.8rem;
  }

  .nav-menu a {
    color: var(--brand-ink);
    font-weight: 500;
    text-transform: uppercase;
    font-size: 0.9rem;
  }

  .nav-link-row {
    display: block;
  }

  .submenu-toggle {
    display: none;
  }

  .submenu {
    display: none;
    position: absolute;
    top: calc(100% + 0.2rem);
    left: 0;
    min-width: 240px;
    list-style: none;
    margin: 0;
    padding: 0.6rem 0;
    background: white;
    border: 1px solid rgba(23, 48, 79, 0.08);
    border-radius: 16px;
    box-shadow: 0 18px 34px rgba(21, 38, 58, 0.12);
    z-index: 30;
  }

  .submenu::before {
    content: '';
    position: absolute;
    top: -8px;
    left: 28px;
    width: 14px;
    height: 14px;
    background: white;
    border-top: 1px solid rgba(23, 48, 79, 0.08);
    border-left: 1px solid rgba(23, 48, 79, 0.08);
    transform: rotate(45deg);
  }

  .submenu li {
    border-bottom: 0;
  }

  .submenu a {
    display: block;
    padding: 0.7rem 1rem;
    font-size: 0.86rem;
    white-space: nowrap;
  }

  .nav-item-with-children:hover .submenu,
  .nav-item-with-children:focus-within .submenu {
    display: block;
  }

  .nav-menu a:hover {
    color: var(--brand-green);
    text-decoration: none;
  }

  .nav-menu a.active {
    color: var(--brand-green);
    font-weight: 700;
  }

  .mobile-lang-switch {
    display: none;
  }

  .mobile-nav-actions {
    display: none;
  }

  .hamburger {
    display: none;
    flex-direction: column;
    background: none;
    border: none;
    cursor: pointer;
    gap: 0.5rem;
    padding: 0;
  }

  .hamburger span {
    width: 25px;
    height: 3px;
    background: var(--brand-navy);
  }

  @media (max-width: 768px) {
    .nav-item-with-children::after {
      display: none;
    }

    .topbar {
      padding: 0.45rem 0;
    }

    .topbar-inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
    }

    .topbar-left {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      width: auto;
    }

    .topbar-right {
      display: flex;
      justify-content: flex-end;
      align-items: center;
      gap: 0.45rem;
      width: auto;
    }

    .topbar-credentials {
      align-items: flex-start;
      display: none;
    }

    .topbar-phone {
      min-height: 34px;
      justify-content: flex-start;
      font-size: 0.94rem;
      border: 0;
      border-radius: 0;
      background: transparent;
    }

    .sms-link,
    .square-link {
      display: none;
    }

    .topbar-right a {
      margin-left: 0;
    }

    .topbar-right .lang-switch {
      display: inline-flex;
    }

    .lang-pill {
      min-width: 2.05rem;
      padding: 0.28rem 0.5rem;
      font-size: 0.76rem !important;
    }

    .topbar-right > a {
      display: none;
    }

    .navbar {
      padding: 0.55rem 0;
    }

    .logo img {
      height: 42px;
    }

    .nav-panel {
      position: absolute;
      top: calc(100% + 0.35rem);
      left: 0.75rem;
      right: 0.75rem;
      display: none;
      flex-direction: column;
      align-items: stretch;
      gap: 0.85rem;
      background: white;
      padding: 0.9rem;
      border: 1px solid rgba(23, 48, 79, 0.08);
      border-radius: 20px;
      box-shadow: 0 20px 36px rgba(21, 38, 58, 0.16);
      max-height: calc(100vh - 104px);
      overflow-y: auto;
    }

    .header[data-menu-open='true'] .nav-panel {
      display: flex;
    }

    .nav-menu {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
    }

    .nav-menu li {
      border-bottom: 0;
    }

    .nav-link-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
    }

    .nav-menu a {
      display: block;
      padding: 0.78rem 0.95rem;
      border-radius: 14px;
      background: #f7f9fb;
      font-size: 0.93rem;
    }

    .nav-item-with-children > .nav-link-row > a {
      flex: 1;
    }

    .nav-menu a.active {
      background: #fff9e5;
    }

    .submenu-toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2.5rem;
      height: 2.5rem;
      border: 0;
      background: #f7f9fb;
      border-radius: 14px;
      color: var(--brand-navy);
      cursor: pointer;
      padding: 0;
      transition: transform 0.2s ease;
    }

    .nav-item-with-children[data-submenu-open='true'] .submenu-toggle {
      transform: rotate(180deg);
    }

    .submenu {
      list-style: none;
      padding: 0.3rem 0 0 0.55rem;
      margin: 0;
    }

    .nav-item-with-children[data-submenu-open='true'] .submenu {
      display: block;
    }

    .submenu li {
      border-bottom: 0;
    }

    .submenu a {
      padding: 0.65rem 0.85rem;
      font-size: 0.83rem;
      text-transform: none;
      color: var(--brand-muted);
      background: transparent;
    }

    .mobile-nav-actions {
      display: grid;
      grid-template-columns: 1fr;
      gap: 0.7rem;
    }

    .mobile-nav-action {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.55rem;
      min-height: 46px;
      padding: 0.8rem 1rem;
      border-radius: 999px;
      font-weight: 700;
      text-decoration: none;
    }

    .mobile-nav-action--primary {
      background: var(--brand-gold);
      color: var(--brand-navy-dark);
    }

    .mobile-nav-action--secondary {
      background: var(--brand-navy-dark);
      color: white;
    }

    .mobile-nav-action:hover {
      text-decoration: none;
    }

    .mobile-lang-switch {
      display: grid;
      gap: 0.45rem;
      padding-top: 0.25rem;
      border-top: 1px solid rgba(23, 48, 79, 0.08);
    }

    .mobile-lang-switch span {
      color: var(--brand-muted);
      font-size: 0.82rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .mobile-lang-switch .lang-switch .lang-pill {
      border-color: rgba(31, 58, 95, 0.18);
      color: var(--brand-navy);
    }

    .hamburger {
      display: flex;
    }
  }
</style>
