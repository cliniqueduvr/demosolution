---
type FAQItem = {
  question: string;
  answer: string;
};

type InfoCard = {
  title: string;
  body: string;
};

type ContentSection = {
  title: string;
  body?: string;
  cards?: InfoCard[];
  list?: string[];
  alt?: boolean;
};

export interface Props {
  eyebrow?: string;
  title: string;
  intro: string;
  heroCardTitle: string;
  heroCardItems: string[];
  sections: ContentSection[];
  faqs: FAQItem[];
  ctaTitle: string;
  ctaBody: string;
  serviceLabel?: string;
}

const {
  eyebrow = 'Page locale ciblée',
  title,
  intro,
  heroCardTitle,
  heroCardItems,
  sections,
  faqs,
  ctaTitle,
  ctaBody,
  serviceLabel = 'demandes locales'
} = Astro.props as Props;

const serviceLinks = [
  { href: '/services/decontamination/', label: 'Décontamination', icon: 'fas fa-biohazard' },
  { href: '/services/moisissure/', label: 'Moisissures', icon: 'fas fa-shield-virus' },
  { href: '/services/enlevement-vermiculite/', label: 'Vermiculite', icon: 'fas fa-exclamation-triangle' },
  { href: '/services/echantillonnage/', label: 'Échantillonnage', icon: 'fas fa-microscope' }
];

const serviceAreas = ['Gatineau', 'Outaouais', 'Ottawa', 'Québec'];
const serviceAreaHref = (area: string) => {
  if (area === 'Gatineau') return '/gatineau/';
  if (area === 'Outaouais') return '/outaouais/';
  if (area === 'Ottawa') return '/ottawa/';
  if (area === 'Québec') return '/ville-de-quebec/';
  return '/soumission/';
};
---

<section class="local-hero">
  <div class="container hero-grid">
    <div>
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      <p>{intro}</p>
    </div>
    <div class="hero-card">
      <h2>{heroCardTitle}</h2>
      <ul>
        {heroCardItems.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </div>
</section>

<section class="local-body">
  <div class="container local-layout">
    <div class="local-main">
      {sections.map((section) => (
        <section class:list={['content-card', section.alt && 'alt']}>
          <h2>{section.title}</h2>
          {section.body && <p class="section-copy">{section.body}</p>}
          {section.cards && (
            <div class="info-grid">
              {section.cards.map((item) => (
                <article class="info-card">
                  <h3>{item.title}</h3>
                  <p>{item.body}</p>
                </article>
              ))}
            </div>
          )}
          {section.list && (
            <ul>
              {section.list.map((item) => <li>{item}</li>)}
            </ul>
          )}
        </section>
      ))}

      <section class="content-card faq-section">
        <h2>Questions fréquentes</h2>
        <div class="faq-list">
          {faqs.map((item) => (
            <details class="faq-item">
              <summary>
                <h3>{item.question}</h3>
              </summary>
              <div class="accordion-content">
                <p>{item.answer}</p>
              </div>
            </details>
          ))}
        </div>
      </section>
    </div>

    <aside class="local-side">
      <div class="cta-card">
        <h2>{ctaTitle}</h2>
        <p>{ctaBody}</p>
        <a class="phone-button" href="tel:5813373366">(581) 337-3366</a>
        <a class="contact-link" href="/soumission/">Demander une soumission</a>
      </div>

      <div class="side-card">
        <h3>Autres services</h3>
        <nav class="service-nav" aria-label="Autres services">
          {serviceLinks.map((item) => (
            <a href={item.href}>
              <i class={item.icon}></i>
              <span>{item.label}</span>
            </a>
          ))}
        </nav>
      </div>

      <div class="side-card">
        <h3>Zones desservies</h3>
        <p class="side-copy">
          Cette page complète les demandes locales liées à {serviceLabel}, avec des liens utiles vers les autres secteurs couverts.
        </p>
        <div class="service-area-side-list">
          {serviceAreas.map((area) => (
            <a href={serviceAreaHref(area)} class="service-area-side-card">
              <h4>{area}</h4>
              <p>Accompagnement offert pour les demandes locales à {area} et dans les environs.</p>
            </a>
          ))}
        </div>
      </div>
    </aside>
  </div>
</section>

<style>
  .local-hero {
    padding: 4.5rem 0 3.8rem;
    background:
      radial-gradient(circle at top left, rgba(242, 210, 27, 0.18), transparent 25%),
      linear-gradient(135deg, var(--brand-navy-dark) 0%, #1f476d 58%, #eef3f7 58%, #eef3f7 100%);
  }

  .eyebrow {
    display: inline-flex;
    margin-bottom: 1rem;
    padding: 0.45rem 0.85rem;
    border-radius: 999px;
    background: rgba(255,255,255,0.12);
    color: var(--brand-gold);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(280px, 0.85fr);
    gap: 2rem;
    align-items: center;
  }

  .local-hero h1 {
    color: white;
    margin-bottom: 0.75rem;
    font-size: 3rem;
  }

  .local-hero p:not(.eyebrow) {
    color: #e7edf4;
    max-width: 58ch;
    font-size: 1.06rem;
  }

  .hero-card,
  .content-card,
  .side-card,
  .cta-card {
    background: white;
    border-radius: 22px;
    padding: 1.5rem;
    box-shadow: 0 16px 30px rgba(18, 35, 54, 0.08);
  }

  .hero-card h2,
  .content-card h2,
  .cta-card h2,
  .side-card h3 {
    margin-bottom: 0.85rem;
  }

  .hero-card ul,
  .content-card ul {
    padding-left: 1.25rem;
  }

  .hero-card li,
  .content-card li {
    margin: 0.45rem 0;
  }

  .local-body {
    padding: 0 0 4.5rem;
  }

  .local-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(290px, 0.85fr);
    gap: 1.8rem;
    align-items: start;
  }

  .local-main,
  .local-side {
    display: grid;
    gap: 1.6rem;
  }

  .section-copy {
    margin-bottom: 1rem;
  }

  .info-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .info-card {
    border-radius: 18px;
    background: #f7f8fa;
    padding: 1.15rem;
  }

  .alt {
    background: linear-gradient(180deg, #fff9e8 0%, #ffffff 100%);
    border: 1px solid rgba(242, 210, 27, 0.35);
  }

  .cta-card {
    position: sticky;
    top: 7rem;
    background: var(--brand-navy-dark);
    color: white;
  }

  .cta-card h2 {
    color: white;
  }

  .cta-card p {
    color: #dbe4ee;
  }

  .phone-button,
  .contact-link {
    display: block;
    text-align: center;
    text-decoration: none;
    border-radius: 999px;
    padding: 0.9rem 1rem;
    font-weight: 700;
  }

  .phone-button {
    margin: 0.4rem 0 0.8rem;
    background: var(--brand-gold);
    color: var(--brand-navy-dark);
    border: 2px solid var(--brand-gold);
  }

  .phone-button:hover {
    text-decoration: none;
    background: #e1c317;
    border-color: #e1c317;
  }

  .contact-link {
    background: rgba(255, 255, 255, 0.12);
    color: white;
  }

  .contact-link:hover {
    text-decoration: none;
    background: rgba(255, 255, 255, 0.2);
  }

  .service-nav,
  .service-area-side-list {
    display: grid;
    gap: 0.8rem;
  }

  .service-nav a,
  .service-area-side-card {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 1rem 1.05rem;
    border-radius: 16px;
    background: #f7f8fa;
    text-decoration: none;
    color: inherit;
  }

  .service-area-side-card {
    display: block;
  }

  .service-area-side-card:hover {
    text-decoration: none;
    background: #fff4b1;
  }

  .faq-list {
    display: grid;
    gap: 0.85rem;
  }

  .faq-item {
    border-radius: 16px;
    background: #f7f8fa;
    padding: 0.25rem 1rem;
  }

  .faq-item summary {
    cursor: pointer;
    list-style: none;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .accordion-content {
    padding: 0 0 0.85rem;
  }

  @media (max-width: 980px) {
    .hero-grid,
    .local-layout,
    .info-grid {
      grid-template-columns: 1fr;
    }

    .cta-card {
      position: static;
    }
  }
</style>
