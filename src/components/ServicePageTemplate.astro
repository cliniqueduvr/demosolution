---
import siteSettings from '../data/site-settings.json';
import type { ServicePage } from '../data/service-page-types';

interface Props {
  service: ServicePage;
  allServices: ServicePage[];
  lang?: 'fr' | 'en';
}

const { service, allServices, lang = 'fr' } = Astro.props as Props;
const otherServices = allServices.filter((item) => item.slug !== service.slug);
const isEnglish = lang === 'en';
const contactHref = isEnglish ? '/en/contact/' : '/contact/';
const serviceHref = (slug: string) => isEnglish ? `/en/services/${slug}/` : `/services/${slug}/`;
const serviceAreas = isEnglish
  ? ['Gatineau', 'Ottawa', 'Quebec City']
  : ['Gatineau', 'Ottawa', 'Québec'];
---

<main>
  <section class="service-hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">{service.eyebrow}</p>
        <h1 class:list={[
          (service.slug === 'decontamination' || service.slug === 'demolition-selective' || service.slug === 'selective-demolition') && 'hero-title-wide',
          service.slug === 'decontamination' && 'hero-title-wider'
        ]}>{service.h1}</h1>
        <p class="opening">{service.opening}</p>
        <p class="lead">{service.lead}</p>
        <p class="intro">{service.intro}</p>

        <div class="hero-badges">
          {service.highlights.map((item) => (
            <span>{item}</span>
          ))}
        </div>
      </div>

      <aside class="hero-card">
        <div class="hero-icon">
          <i class="fas fa-microscope"></i>
        </div>
        <h2>{isEnglish ? 'Need sampling before moving forward?' : 'Besoin d’un échantillonnage avant d’aller plus loin?'}</h2>
        <p>{isEnglish ? 'We can help you validate suspicious materials, choose the right sampling approach, and decide on the next useful step for your property.' : 'On peut vous aider à valider des matériaux suspects, à choisir le bon type d’échantillonnage et à décider de la prochaine étape utile pour votre propriété.'}</p>
        <a class="hero-link" href={contactHref}>{isEnglish ? 'Talk to us about sampling' : 'Parler d’échantillonnage'}</a>
      </aside>
    </div>
  </section>

  <section class="service-body">
    <div class="container body-grid">
      {service.warningTitle && service.warningBody && (
        <section class="warning-band">
          <div class="warning-icon">
            <i class="fas fa-exclamation-triangle"></i>
          </div>
          <div class="warning-copy">
            <h2>{service.warningTitle}</h2>
            <p>{service.warningBody}</p>
          </div>
        </section>
      )}

      <article class="service-main">
        <section class="content-card">
          <h2>{service.includedTitle}</h2>
          <p class="section-copy">{service.detailIntro}</p>
          <ul>
            {service.included.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </section>

        <section class="content-card alt">
          <h2>{service.situationsTitle}</h2>
          <ul>
            {service.situations.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </section>

        <section class="content-card">
          <h2>{isEnglish ? 'How we work' : 'Notre façon de travailler'}</h2>
          <p class="section-copy">{service.processIntro}</p>
          <ol>
            {service.process.map((item) => (
              <li>{item}</li>
            ))}
          </ol>
        </section>

        <section class="content-card alt">
          <h2>{service.whyChooseTitle}</h2>
          <p class="section-copy">{service.whyChooseIntro}</p>
          <div class="why-choose-grid">
            {service.whyChoose.map((item) => (
              <article class="why-card">
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </article>
            ))}
          </div>
        </section>

        <section class="content-card">
          <h2>{isEnglish ? 'Areas served for this service' : 'Zones desservies pour ce service'}</h2>
          <p class="section-copy">
            {isEnglish
              ? 'This service is offered from Gatineau and, depending on the type of work, may also extend to Ottawa and Quebec City.'
              : 'Ce service est offert à partir de Gatineau et, selon le type d’intervention, peut aussi inclure Ottawa et Québec.'}
          </p>
          <div class="link-card-grid">
            {serviceAreas.map((area) => (
              <article class="link-card">
                <h3>{area}</h3>
                <p>
                  {isEnglish
                    ? `Support available for ${service.navLabel.toLowerCase()} requests in and around ${area}.`
                    : `Accompagnement offert pour les demandes de ${service.navLabel.toLowerCase()} à ${area} et dans les environs.`}
                </p>
              </article>
            ))}
          </div>
        </section>

        <section class="content-card faq-section">
          <h2>{service.faqTitle}</h2>
          <div class="faq-list">
            {service.faqs.map((item) => (
              <details class="faq-item">
                <summary>
                  <h3>{item.question}</h3>
                </summary>
                <div class="accordion-content">
                  <p>{item.answer}</p>
                </div>
              </details>
            ))}
          </div>
        </section>
      </article>

      <aside class="service-side">
        <div class="side-card sticky">
          <h3>{isEnglish ? 'Need a quick opinion?' : "Besoin d'un avis rapide?"}</h3>
          <p>{isEnglish ? 'We can point you toward the right intervention based on the actual condition of the property.' : "On peut vous orienter vers la bonne intervention selon l'état réel de la propriété."}</p>
          <a class="side-button" href={`tel:${siteSettings.phone.href}`}>{siteSettings.phone.display}</a>
          <a class="side-link" href={siteSettings.squareBookingUrl} target="_blank" rel="noopener">{isEnglish ? 'Request a quote' : 'Demander une soumission'}</a>
        </div>

        <div class="side-card">
          <h3>{isEnglish ? 'Other services' : 'Autres services'}</h3>
          <nav class="service-nav" aria-label={isEnglish ? 'Other services' : 'Autres services'}>
            {otherServices.map((item) => (
              <a href={serviceHref(item.slug)}>
                <i class={item.icon}></i>
                <span>{item.navLabel}</span>
              </a>
            ))}
          </nav>
        </div>
      </aside>
    </div>
  </section>

</main>

<style>
  .service-hero {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle at top left, rgba(242, 210, 27, 0.18), transparent 32%),
      linear-gradient(135deg, var(--brand-navy-dark) 0%, #23476f 58%, #f4f6f8 58%, #f4f6f8 100%);
    padding: 4.5rem 0 4rem;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(280px, 0.75fr);
    gap: 2rem;
    align-items: stretch;
  }

  .hero-copy {
    color: white;
  }

  .eyebrow {
    display: inline-flex;
    padding: 0.45rem 0.85rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.12);
    color: var(--brand-gold);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 1.25rem;
  }

  .hero-copy h1 {
    max-width: 19ch;
    margin-bottom: 1rem;
    color: white;
    line-height: 1;
  }

  .hero-copy h1.hero-title-wide {
    max-width: 23ch;
  }

  .hero-copy h1.hero-title-wider {
    max-width: 28ch;
  }

  .lead {
    font-size: 1.2rem;
    line-height: 1.7;
    color: #f5f7fa;
    max-width: 60ch;
  }

  .opening {
    max-width: 64ch;
    font-size: 1.08rem;
    color: #dbe4ee;
    margin-bottom: 1rem;
  }

  .intro {
    margin-top: 1rem;
    max-width: 62ch;
    color: #dbe4ee;
  }

  .hero-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1.75rem;
  }

  .hero-badges span {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.75rem 1rem;
    border-radius: 14px;
    background: var(--brand-gold);
    border: 1px solid var(--brand-gold);
    color: var(--brand-navy-dark);
    font-weight: 700;
    box-shadow: 0 10px 18px rgba(14, 31, 49, 0.14);
  }

  .hero-card {
    align-self: end;
    width: 100%;
    box-sizing: border-box;
    background: white;
    border-radius: 24px;
    padding: 2rem;
    box-shadow: 0 22px 44px rgba(16, 35, 56, 0.22);
  }

  .hero-icon {
    width: 4rem;
    height: 4rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 18px;
    background: linear-gradient(135deg, var(--brand-green), #57af49);
    color: white;
    font-size: 1.5rem;
    margin-bottom: 1rem;
  }

  .hero-card h2 {
    font-size: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .hero-card p {
    color: var(--brand-muted);
    margin-bottom: 1.25rem;
  }

  .hero-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 48px;
    padding: 0.85rem 1rem;
    border-radius: 999px;
    background: var(--brand-navy);
    color: white;
    font-weight: 700;
    text-decoration: none;
  }

  .hero-link:hover {
    text-decoration: none;
    background: var(--brand-navy-dark);
  }

  .service-body {
    padding: 4rem 0;
    background:
      linear-gradient(180deg, #ffffff 0%, #ffffff 42%, #f3f5f8 42%, #f3f5f8 100%);
  }

  .body-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(280px, 0.75fr);
    gap: 2rem;
    align-items: start;
  }

  .service-main,
  .service-side {
    display: grid;
    gap: 1.5rem;
  }

  .content-card,
  .side-card {
    background: white;
    border-radius: 22px;
    padding: 1.75rem;
    box-shadow: 0 16px 34px rgba(24, 40, 61, 0.08);
  }

  .content-card.alt {
    background: linear-gradient(180deg, #f8fbf5 0%, #ffffff 100%);
  }

  .content-card h2,
  .side-card h3 {
    margin-bottom: 1rem;
  }

  .content-card ul,
  .content-card ol {
    display: grid;
    gap: 0.85rem;
    padding-left: 1.2rem;
    color: var(--brand-ink);
  }

  .section-copy {
    margin-bottom: 1rem;
    color: var(--brand-muted);
  }

  .content-card li::marker {
    color: var(--brand-green);
    font-weight: 700;
  }

  .why-choose-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
  }

  .link-card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
  }

  .why-card {
    background: var(--brand-surface);
    border-radius: 16px;
    padding: 1rem;
  }

  .warning-band {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    grid-column: 1 / -1;
    gap: 1.25rem;
    align-items: center;
    padding: 2.15rem 1.9rem 1.85rem;
    border-radius: 24px;
    background: linear-gradient(180deg, #fff8bf 0%, #fff2a3 100%);
    box-shadow: 0 18px 34px rgba(24, 40, 61, 0.08);
    border: 2px solid rgba(16, 24, 32, 0.14);
    overflow: hidden;
  }

  .warning-band::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 16px;
    background: repeating-linear-gradient(
      -45deg,
      #101820 0 18px,
      #101820 18px 24px,
      #ffd200 24px 42px,
      #ffd200 42px 48px
    );
  }

  .warning-icon {
    width: 4rem;
    height: 4rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 18px;
    background: #101820;
    color: #ffd200;
    font-size: 1.5rem;
    box-shadow: 0 10px 20px rgba(21, 38, 58, 0.12);
    margin-top: 0.25rem;
  }

  .warning-copy h2 {
    margin-bottom: 0.75rem;
    color: #101820;
  }

  .warning-copy p {
    margin: 0;
    color: rgba(16, 24, 32, 0.88);
  }

  .link-card {
    background: var(--brand-surface);
    border-radius: 16px;
    padding: 1rem;
  }

  .why-card h3,
  .faq-item h3,
  .link-card h3 {
    font-size: 1rem;
    margin-bottom: 0.45rem;
  }

  .why-card p,
  .faq-item p,
  .link-card p {
    color: var(--brand-muted);
  }

  .link-card span {
    color: var(--brand-navy);
    font-weight: 700;
  }

  .faq-list {
    display: grid;
    gap: 1rem;
  }

  .faq-item {
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(31, 58, 95, 0.08);
  }

  .faq-item summary {
    list-style: none;
    cursor: pointer;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .accordion-content {
    display: grid;
    gap: 0.85rem;
    padding-top: 1rem;
  }

  .faq-item:last-child {
    padding-bottom: 0;
    border-bottom: none;
  }

  .sticky {
    width: 100%;
    box-sizing: border-box;
    background: var(--brand-navy-dark);
    color: white;
  }

  .sticky h3 {
    color: white;
  }

  .sticky p {
    color: #dbe4ee;
  }

  .side-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 48px;
    border-radius: 999px;
    background: var(--brand-gold);
    color: var(--brand-navy-dark);
    font-weight: 700;
    text-decoration: none;
    margin: 0.25rem 0 0.75rem;
  }

  .side-button:hover {
    text-decoration: none;
    background: #e2c417;
  }

  .side-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 48px;
    padding: 0.55rem 1rem;
    border-radius: 999px;
    background: var(--brand-gold);
    border: 2px solid var(--brand-gold);
    color: var(--brand-navy-dark);
    font-weight: 700;
    text-decoration: none;
  }

  .side-link:hover {
    text-decoration: none;
    background: #e1c317;
    border-color: #e1c317;
  }

  .service-nav {
    display: grid;
    gap: 0.7rem;
  }

  .service-nav a {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    min-height: 54px;
    padding: 0.9rem 1rem;
    border-radius: 16px;
    background: var(--brand-surface);
    color: var(--brand-ink);
    text-decoration: none;
    font-weight: 700;
  }

  .service-nav a:hover {
    text-decoration: none;
    background: #eaf1e6;
  }

  .service-nav i {
    color: var(--brand-green);
  }

  @media (max-width: 920px) {
    .hero-grid,
    .body-grid,
    .warning-band {
      grid-template-columns: 1fr;
    }

    .hero-copy h1 {
      max-width: none;
    }
    
    .hero-copy h1.hero-title-wide {
      max-width: none;
    }

  }

  @media (max-width: 768px) {
    .service-hero {
      padding: 3.25rem 0 3rem;
      background:
        radial-gradient(circle at top left, rgba(242, 210, 27, 0.18), transparent 38%),
        linear-gradient(180deg, var(--brand-navy-dark) 0%, #23476f 100%);
    }

    .lead {
      font-size: 1.05rem;
    }

    .service-body {
      padding: 3rem 0;
      background: #f3f5f8;
    }

    .content-card,
    .side-card,
    .hero-card {
      border-radius: 18px;
      padding: 1.3rem;
    }
  }
</style>
