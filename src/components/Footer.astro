---
import CTABanner from './CTABanner.astro';
import siteSettings from '../data/site-settings.json';

export interface Props {
  lang?: 'fr' | 'en';
}

const { lang = 'fr' } = Astro.props as Props;
const isEnglish = lang === 'en';
const pathname = Astro.url.pathname;
const shouldShowCta = pathname !== '/contact/' && pathname !== '/en/contact/';
const facebookUrl = siteSettings.facebookUrl?.trim();
const tiktokUrl = siteSettings.tiktokUrl?.trim();
const cityLinks = isEnglish
  ? [
      { label: 'Gatineau' },
      { label: 'Ottawa' }
    ]
  : [
      { label: 'Gatineau', href: '/gatineau/' },
      { label: 'Ottawa', href: '/ottawa/' }
    ];
const resourceLinks = isEnglish
  ? [
      { label: 'FAQ', href: '/en/faq/' },
      { label: 'Sampling', href: '/en/services/sampling/' },
      { label: 'Mould Pricing', href: '/en/mould-pricing/' },
      { label: 'Vermiculite Pricing', href: '/en/vermiculite-pricing/' },
      { label: 'Projects', href: '/en/realisations/' },
      { label: 'Privacy Policy', href: '/en/privacy/' },
      { label: 'Site Map', href: '/en/site-map/' }
    ]
  : [
      { label: 'Guide amiante', href: '/amiante/' },
      { label: 'Guide moisissure', href: '/moisissure/' },
      { label: "Inspection qualité de l'air", href: '/inspection-qualite-air/' },
      { label: 'FAQ', href: '/faq/' },
      { label: 'Réalisations', href: '/realisations/' },
      { label: 'Tarifs moisissure', href: '/tarifs-moisissure/' },
      { label: 'Tarifs vermiculite', href: '/tarifs-vermiculite/' },
      { label: 'Politique de confidentialité', href: '/privacy/' },
      { label: 'Plan du site', href: '/plan-du-site/' }
    ];
---

{shouldShowCta && <CTABanner lang={isEnglish ? 'en' : 'fr'} />}

<footer class="footer">
  <div class="container footer-content">
    <div class="footer-col">
      <img class="footer-brand" src={siteSettings.brandImage} alt={siteSettings.brandName} />
      <p>{isEnglish ? siteSettings.footerDescription.en : siteSettings.footerDescription.fr}</p>
    </div>
    <div class="footer-col">
      <h4>{isEnglish ? 'Contact' : 'Contact'}</h4>
      <p>
        <strong>{isEnglish ? 'Phone:' : 'Téléphone:'}</strong> <a href={`tel:${siteSettings.phone.href}`}>{siteSettings.phone.display}</a><br>
        <strong>Email:</strong> <a href={`mailto:${siteSettings.email}`}>{siteSettings.email}</a><br>
        <strong>{isEnglish ? 'Insurance:' : 'Assurance:'}</strong> {isEnglish ? 'Pollution and $2M liability' : 'Pollution et civile 2 millions'}
      </p>
    </div>
    <div class="footer-col">
      <h4>{isEnglish ? 'Services' : 'Services'}</h4>
      <ul>
        <li><a href={isEnglish ? '/en/services/decontamination/' : '/services/decontamination/'}>{isEnglish ? 'Decontamination' : 'Décontamination'}</a></li>
        <li><a href={isEnglish ? '/en/services/mould-removal/' : '/services/moisissure/'}>{isEnglish ? 'Mould removal' : 'Moisissures'}</a></li>
        <li><a href={isEnglish ? '/en/services/vermiculite-removal/' : '/services/enlevement-vermiculite/'}>{isEnglish ? 'Vermiculite removal' : 'Enlèvement de vermiculite'}</a></li>
        <li><a href={isEnglish ? '/en/services/sampling/' : '/services/echantillonnage/'}>{isEnglish ? 'Sampling' : 'Échantillonnage'}</a></li>
        <li><a href={isEnglish ? '/en/services/selective-demolition/' : '/services/demolition-selective/'}>{isEnglish ? 'Selective demolition' : 'Démolition'}</a></li>
      </ul>
    </div>
    <div class="footer-col">
      <h4>{isEnglish ? 'Cities Served' : 'Villes desservies'}</h4>
      <ul>
        {cityLinks.map((item) => (
          <li>
            {item.href ? <a href={item.href}>{item.label}</a> : <span>{item.label}</span>}
          </li>
        ))}
      </ul>
    </div>
    <div class="footer-col">
      <h4>{isEnglish ? 'Resources' : 'Ressources'}</h4>
      <ul class="footer-link-list">
        {resourceLinks.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </div>
  </div>
  <div class="footer-accreditations">
    <div class="container">
      <p class="footer-accreditations-title">{isEnglish ? 'Accreditations and compliance' : 'Accréditations et conformité'}</p>
      <div class="footer-accreditations-grid">
        <div class="footer-accreditation-card footer-accreditation-card--text">
          <span>CNESST</span>
        </div>
        <div class="footer-accreditation-card footer-accreditation-card--text">
          <span>RBQ</span>
        </div>
        <div class="footer-accreditation-card footer-accreditation-card--text">
          <span>ASP Construction</span>
        </div>
        <div class="footer-accreditation-card footer-accreditation-card--text">
          <span>IICRC</span>
        </div>
        <div class="footer-accreditation-card footer-accreditation-card--text">
          <span>APCHQ</span>
        </div>
      </div>
    </div>
  </div>
  <div class="footer-bottom">
    <div class="container">
      <p>&copy; 2026 {siteSettings.brandName}. {isEnglish ? 'All rights reserved.' : 'Tous droits réservés.'}</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--brand-navy);
    color: white;
    padding: 3rem 0 0;
    margin-top: 0;
  }

  .footer-content {
    display: grid;
    grid-template-columns: minmax(210px, 1.35fr) repeat(4, minmax(0, 1fr));
    gap: 1.35rem;
    padding: 1.75rem 2rem 0.35rem;
    align-items: start;
  }

  .footer-brand {
    height: 68px;
    width: auto;
    display: block;
    margin-bottom: 1rem;
    background: white;
    border-radius: 10px;
    padding: 0.35rem;
  }

  .footer-col h4 {
    color: var(--brand-gold);
    text-transform: uppercase;
    margin-bottom: 1rem;
  }

  .footer-col a {
    color: white;
    transition: color 0.2s ease, transform 0.2s ease;
    display: inline-block;
  }

  .footer-col span {
    color: white;
    display: inline-block;
  }

  .footer-col a:hover {
    color: var(--brand-gold);
    text-decoration: none;
    transform: translateX(2px);
  }

  .footer-legal {
    margin-top: 1rem;
  }

  .footer-col ul {
    list-style: none;
  }

  .footer-col ul li {
    margin: 0.5rem 0;
  }

  .footer-link-list {
    display: block;
  }

  .footer-link-list li {
    margin: 0.5rem 0;
  }

  .footer-bottom {
    background: var(--brand-navy-dark);
    padding: 1rem;
    text-align: center;
    border-top: 3px solid var(--brand-green);
    border-bottom: 3px solid var(--brand-green);
  }

  .footer-accreditations {
    padding: 0 0 1rem;
  }

  .footer-accreditations-title {
    margin: 0 0 0.45rem;
    color: white;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .footer-accreditations-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
    gap: 0.55rem;
  }

  .footer-accreditation-card {
    min-height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem 0.65rem;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
    text-align: center;
  }

  .footer-accreditation-card--text {
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.1) 0%, rgba(255, 255, 255, 0.04) 100%);
  }

  .footer-accreditation-card--text span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 72px;
    min-height: 32px;
    padding: 0.35rem 0.65rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.16);
    color: white;
    font-size: 0.9rem;
    font-weight: 800;
    letter-spacing: 0.03em;
  }

  .footer-bottom a {
    color: var(--brand-gold);
  }

  @media (max-width: 768px) {
    .footer-content {
      grid-template-columns: 1fr;
      gap: 1.15rem;
      padding: 1.35rem 1rem 0.35rem;
    }

    .footer {
      padding-top: 2rem;
    }

    .footer-brand {
      height: 58px;
      margin-bottom: 0.8rem;
    }

    .footer-col h4 {
      margin-bottom: 0.45rem;
      font-size: 0.95rem;
    }

    .footer-col ul li {
      margin: 0.2rem 0;
    }

    .footer-col p,
    .footer-col li,
    .footer-col a,
    .footer-col span {
      font-size: 0.96rem;
    }

    .footer-bottom {
      padding: 0.85rem 1rem;
    }

    .footer-accreditations {
      padding: 0 1rem 1.1rem;
    }

    .footer-accreditations-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
