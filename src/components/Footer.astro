---
import CTABanner from './CTABanner.astro';
import siteSettings from '../data/site-settings.json';

export interface Props {
  lang?: 'fr' | 'en';
}

const { lang = 'fr' } = Astro.props as Props;
const isEnglish = lang === 'en';
const pathname = Astro.url.pathname;
const shouldShowCta = pathname !== '/contact/' && pathname !== '/en/contact/';
const facebookUrl = siteSettings.facebookUrl?.trim();
const tiktokUrl = siteSettings.tiktokUrl?.trim();
---

{shouldShowCta && <CTABanner lang={isEnglish ? 'en' : 'fr'} />}

<footer class="footer">
  <div class="container footer-content">
    <div class="footer-col">
      <img class="footer-brand" src={siteSettings.brandImage} alt={siteSettings.brandName} />
      <p>{isEnglish ? siteSettings.footerDescription.en : siteSettings.footerDescription.fr}</p>
    </div>
    <div class="footer-col">
      <h4>{isEnglish ? 'Contact' : 'Contact'}</h4>
      <p>
        <strong>{isEnglish ? 'Phone:' : 'Téléphone:'}</strong> <a href={`tel:${siteSettings.phone.href}`}>{siteSettings.phone.display}</a><br>
        <a href={siteSettings.squareBookingUrl} target="_blank" rel="noopener" class="footer-square-link">{isEnglish ? 'Request a quote' : 'Demander une soumission'}</a><br>
        <strong>Email:</strong> <a href={`mailto:${siteSettings.email}`}>{siteSettings.email}</a><br>
        <strong>{isEnglish ? 'Insurance:' : 'Assurance:'}</strong> {isEnglish ? '$2M garage and liability' : 'Garage et civile 2 millions'}
      </p>
    </div>
    <div class="footer-col">
      <h4>{isEnglish ? 'Services' : 'Services'}</h4>
      <ul>
        <li><a href={isEnglish ? '/en/services/decontamination/' : '/services/decontamination/'}>{isEnglish ? 'Decontamination' : 'Décontamination'}</a></li>
        <li><a href={isEnglish ? '/en/services/mould-removal/' : '/services/moisissure/'}>{isEnglish ? 'Mould removal' : 'Moisissures'}</a></li>
        <li><a href={isEnglish ? '/en/services/vermiculite-removal/' : '/services/enlevement-vermiculite/'}>{isEnglish ? 'Vermiculite removal' : 'Enlèvement de vermiculite'}</a></li>
        <li><a href={isEnglish ? '/en/services/sampling/' : '/services/echantillonnage/'}>{isEnglish ? 'Sampling' : 'Échantillonnage'}</a></li>
        <li><a href={isEnglish ? '/en/services/selective-demolition/' : '/services/demolition-selective/'}>{isEnglish ? 'Selective demolition' : 'Démolition'}</a></li>
      </ul>
    </div>
    <div class="footer-col">
      <h4>{isEnglish ? 'Follow Us' : 'Nous Suivre'}</h4>
      {facebookUrl && (
        <>
          <a href={facebookUrl} target="_blank" rel="noopener">
            <i class="fab fa-facebook"></i> Facebook
          </a>
          <br />
        </>
      )}
      {tiktokUrl && (
        <a href={tiktokUrl} target="_blank" rel="noopener">
          <i class="fab fa-tiktok"></i> TikTok
        </a>
      )}
      <p class="footer-legal">
        <a href={isEnglish ? '/en/faq/' : '/faq/'}>FAQ</a>
        {' · '}
        <a href={isEnglish ? '/en/mould-pricing/' : '/tarifs-moisissure/'}>{isEnglish ? 'Mould Pricing' : 'Tarifs moisissure'}</a>
        {' · '}
        <a href={isEnglish ? '/en/vermiculite-pricing/' : '/tarifs-vermiculite/'}>{isEnglish ? 'Vermiculite Pricing' : 'Tarifs vermiculite'}</a>
        {' · '}
        <a href={isEnglish ? '/en/privacy/' : '/privacy/'}>{isEnglish ? 'Privacy Policy' : 'Politique de confidentialité'}</a>
        {' · '}
        <a href={isEnglish ? '/en/site-map/' : '/plan-du-site/'}>{isEnglish ? 'Site Map' : 'Plan du site'}</a>
      </p>
    </div>
  </div>
  <div class="footer-accreditations">
    <div class="container">
      <p class="footer-accreditations-title">{isEnglish ? 'Accreditations and compliance' : 'Accréditations et conformité'}</p>
      <div class="footer-accreditations-grid">
        <div class="footer-accreditation-card">
          <img src="/accreditation-cnesst.png" alt="CNESST" class="footer-accreditation-logo footer-accreditation-logo-cnesst" />
        </div>
        <div class="footer-accreditation-card">
          <img src="/accreditation-rbq.png" alt="RBQ" class="footer-accreditation-logo footer-accreditation-logo-rbq" />
        </div>
        <div class="footer-accreditation-card">
          <span>ASP Construction</span>
        </div>
        <div class="footer-accreditation-card">
          <img src="/accreditation-iicrc.jpg" alt="IICRC" class="footer-accreditation-logo footer-accreditation-logo-iicrc" />
        </div>
        <div class="footer-accreditation-card">
          <img src="/accreditation-apchq.avif" alt="APCHQ" class="footer-accreditation-logo footer-accreditation-logo-apchq" />
        </div>
      </div>
    </div>
  </div>
  <div class="footer-bottom">
    <div class="container">
      <p>&copy; 2026 {siteSettings.brandName}. {isEnglish ? 'All rights reserved.' : 'Tous droits réservés.'}</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--brand-navy);
    color: white;
    padding: 3rem 0 0;
    margin-top: 0;
  }

  .footer-content {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
    padding: 2rem;
  }

  .footer-brand {
    height: 68px;
    width: auto;
    display: block;
    margin-bottom: 1rem;
    background: white;
    border-radius: 10px;
    padding: 0.35rem;
  }

  .footer-col h4 {
    color: var(--brand-gold);
    text-transform: uppercase;
    margin-bottom: 1rem;
  }

  .footer-col a {
    color: white;
  }

  .footer-square-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    margin: 0.35rem 0;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    background: var(--brand-gold);
    color: var(--brand-navy-dark) !important;
    border: 2px solid var(--brand-gold);
    font-weight: 700;
    text-decoration: none;
  }

  .footer-square-link:hover {
    text-decoration: none;
    background: #e1c317;
    border-color: #e1c317;
  }

  .footer-legal {
    margin-top: 1rem;
  }

  .footer-col ul {
    list-style: none;
  }

  .footer-col ul li {
    margin: 0.5rem 0;
  }

  .footer-bottom {
    background: var(--brand-navy-dark);
    padding: 1rem;
    text-align: center;
    border-top: 3px solid var(--brand-green);
  }

  .footer-accreditations {
    padding: 0 0 2rem;
  }

  .footer-accreditations-title {
    margin: 0 0 1rem;
    color: white;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .footer-accreditations-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1rem;
  }

  .footer-accreditation-card {
    min-height: 84px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
    text-align: center;
  }

  .footer-accreditation-card span {
    color: white;
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: 0.03em;
  }

  .footer-accreditation-logo {
    display: block;
    max-width: 100%;
    height: auto;
    object-fit: contain;
  }

  .footer-accreditation-logo-iicrc {
    max-height: 48px;
  }

  .footer-accreditation-logo-rbq {
    max-height: 50px;
  }

  .footer-accreditation-logo-apchq {
    max-height: 46px;
  }

  .footer-accreditation-logo-cnesst {
    max-height: 42px;
  }

  .footer-bottom a {
    color: var(--brand-gold);
  }

  @media (max-width: 768px) {
    .footer-content {
      grid-template-columns: 1fr;
      gap: 1.4rem;
      padding: 1.5rem 1rem;
    }

    .footer {
      padding-top: 2rem;
    }

    .footer-brand {
      height: 58px;
      margin-bottom: 0.8rem;
    }

    .footer-col h4 {
      margin-bottom: 0.7rem;
    }

    .footer-col ul li {
      margin: 0.35rem 0;
    }

    .footer-square-link {
      width: 100%;
      padding: 0.75rem 1rem;
    }

    .footer-bottom {
      padding: 0.85rem 1rem;
    }

    .footer-accreditations {
      padding: 0 1rem 1.5rem;
    }

    .footer-accreditations-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
