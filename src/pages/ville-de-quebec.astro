---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import siteSettings from '../data/site-settings.json';
import { buildBreadcrumbSchema, buildFAQSchema } from '../lib/seo';

const serviceLinks = [
  { href: '/services/moisissure/', label: 'Moisissures', icon: 'fas fa-shield-virus' },
  { href: '/services/demolition-selective/', label: 'Démolition', icon: 'fas fa-house-damage' },
  { href: '/services/enlevement-vermiculite/', label: 'Vermiculite', icon: 'fas fa-exclamation-triangle' },
  { href: '/services/echantillonnage/', label: 'Échantillonnage', icon: 'fas fa-microscope' }
];

const serviceAreas = ['Gatineau', 'Ottawa', 'Québec'];

const nearbyAreas = [
  'Sainte-Foy',
  'Beauport',
  'Charlesbourg',
  'Limoilou',
  'Lévis',
  'L’Ancienne-Lorette',
  'Saint-Augustin-de-Desmaures',
  'Shannon',
  'Stoneham-et-Tewkesbury',
  'Boischatel'
];

const commonSituations = [
  {
    title: 'Rénovation de bâtiments plus anciens',
    body: "Plafonds, cloisons, anciens revêtements, isolants, plâtres et matériaux qui doivent être vérifiés avant d'être ouverts ou retirés."
  },
  {
    title: 'Travaux préparatoires avant chantier',
    body: "Repérage de matériaux à risque, échantillonnage, zone à sécuriser et bonne séquence de travaux avant rénovation ou démolition."
  },
  {
    title: 'Problèmes d’humidité et contamination',
    body: "Moisissures, matériaux touchés par l'eau, zones fermées ou mal ventilées, et situations où une correction propre doit précéder la reprise."
  }
];

const localAdvantages = [
  {
    title: 'Interventions à Québec et autour',
    body: "Nous pouvons prendre en charge des mandats dans la ville de Québec et dans ses secteurs périphériques selon la portée et le calendrier du projet."
  },
  {
    title: 'Lecture claire du risque',
    body: "Le bon réflexe n'est pas de tout retirer d'emblée, mais de confirmer ce qui doit l'être et d'utiliser la bonne méthode dès le départ."
  },
  {
    title: 'Approche adaptée au chantier',
    body: "Qu'il s'agisse d'un projet résidentiel, locatif ou d'un bâtiment à rénover, l'intervention doit protéger les occupants et la suite des travaux."
  }
];

const faqs = [
  {
    question: 'Travaillez-vous seulement dans la ville de Québec?',
    answer: "Non. Selon le projet, nous pouvons couvrir Québec et des secteurs périphériques comme Sainte-Foy, Beauport, Charlesbourg, Lévis, L’Ancienne-Lorette, Saint-Augustin-de-Desmaures, Shannon, Stoneham ou Boischatel."
  },
  {
    question: 'Pourquoi faire vérifier avant des rénovations à Québec?',
    answer: "Plusieurs bâtiments ou portions de bâtiments plus anciens peuvent contenir des matériaux à risque. Vérifier avant d'ouvrir, percer ou démolir permet d'éviter une exposition inutile et un chantier mal séquencé."
  },
  {
    question: 'Quels services sont souvent demandés dans le secteur?',
    answer: "Les demandes fréquentes concernent l'échantillonnage, la vermiculite, l'amiante dans certains matériaux anciens, la moisissure après infiltration et la préparation d'un chantier avant travaux."
  },
  {
    question: 'Pouvez-vous intervenir aussi dans la périphérie de Québec?',
    answer: "Oui. La couverture dépend de la portée du mandat, du délai souhaité et du type d'intervention, mais plusieurs secteurs autour de Québec peuvent être pris en charge."
  }
];

const breadcrumbs = buildBreadcrumbSchema([
  { name: 'Accueil', path: '/' },
  { name: 'Ville de Québec' }
]);
---

<Layout
  title="Décontamination, amiante, vermiculite et échantillonnage à Québec"
  description="Services de décontamination, amiante, vermiculite, moisissures et échantillonnage dans la ville de Québec et en périphérie: Sainte-Foy, Beauport, Charlesbourg, Lévis et secteurs voisins."
  canonicalPath="/ville-de-quebec/"
  frPath="/ville-de-quebec/"
  schemas={[breadcrumbs, buildFAQSchema(faqs)]}
>
  <Header />

  <main>
    <section class="local-hero">
      <div class="container hero-grid">
        <div>
          <p class="eyebrow">Secteur local</p>
          <h1>Décontamination, amiante, vermiculite et échantillonnage dans la ville de Québec</h1>
          <p>
            Demo Solution intervient pour des besoins de <strong>décontamination</strong>,
            d’<strong>échantillonnage</strong>, d’<strong>amiante</strong>,
            d’<strong>vermiculite</strong> et de <strong>moisissures</strong> à Québec et
            en périphérie. Avant des travaux, un doute sur un matériau ou une situation de
            contamination, l’important est de poser le bon diagnostic et de choisir la bonne
            intervention avant de poursuivre.
          </p>
        </div>
        <div class="hero-card">
          <h2>Secteurs couverts autour de Québec</h2>
          <ul>
            {nearbyAreas.map((area) => <li>{area}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <section class="local-body">
      <div class="container local-layout">
        <div class="local-main">
          <section class="content-card">
            <h2>Situations fréquentes dans la ville de Québec et la périphérie</h2>
            <div class="info-grid">
              {commonSituations.map((item) => (
                <article class="info-card">
                  <h3>{item.title}</h3>
                  <p>{item.body}</p>
                </article>
              ))}
            </div>
          </section>

          <section class="content-card alt">
            <h2>Ce que les clients veulent surtout éviter</h2>
            <ul>
              <li>Démarrer des travaux sans savoir si un matériau ancien doit être échantillonné.</li>
              <li>Propager poussières, fibres ou contaminants en ouvrant une zone sans méthode adaptée.</li>
              <li>Retarder un chantier parce qu’aucune séquence claire n’a été prévue au départ.</li>
              <li>Traiter une zone humide ou contaminée partiellement, puis devoir reprendre plus loin ensuite.</li>
            </ul>
            <p>
              Une bonne page locale n’a pas seulement pour but de répéter un nom de ville. Elle doit
              répondre à une vraie intention: <strong>quoi faire à Québec lorsqu’un matériau ou un
              chantier soulève un risque réel</strong>.
            </p>
          </section>

          <section class="content-card">
            <h2>Pourquoi nous appeler pour un projet à Québec?</h2>
            <div class="info-grid">
              {localAdvantages.map((item) => (
                <article class="info-card">
                  <h3>{item.title}</h3>
                  <p>{item.body}</p>
                </article>
              ))}
            </div>
          </section>

          <section class="content-card alt">
            <h2>Services utiles pour Québec et les secteurs voisins</h2>
            <ul>
              <li>Échantillonnage de matériaux avant rénovation, ouverture ou démolition.</li>
              <li>Orientation en présence de vermiculite, amiante ou matériaux plus anciens.</li>
              <li>Traitement de situations de moisissure ou de contamination localisée.</li>
              <li>Décontamination ciblée et préparation d’une zone avant la suite des travaux.</li>
              <li>Lecture du risque et recommandations claires pour éviter une mauvaise séquence de chantier.</li>
            </ul>
          </section>

          <section class="content-card faq-section">
            <h2>Questions fréquentes pour Québec et la périphérie</h2>
            <div class="faq-list">
              {faqs.map((item) => (
                <details class="faq-item">
                  <summary>
                    <h3>{item.question}</h3>
                  </summary>
                  <div class="accordion-content">
                    <p>{item.answer}</p>
                  </div>
                </details>
              ))}
            </div>
          </section>
        </div>

        <aside class="local-side">
          <div class="cta-card">
            <h2>Projet dans la ville de Québec?</h2>
            <p>
              Si vous devez confirmer un risque avant des travaux ou remettre un chantier sur la
              bonne voie, nous pouvons vous orienter vers la bonne prochaine étape.
            </p>
            <a class="phone-button" href={`tel:${siteSettings.phone.href}`}>{siteSettings.phone.display}</a>
            <a class="contact-link" href="/contact/">Demander une soumission</a>
          </div>

          <div class="side-card">
            <h3>Autres services</h3>
            <nav class="service-nav" aria-label="Autres services">
              {serviceLinks.map((item) => (
                <a href={item.href}>
                  <i class={item.icon}></i>
                  <span>{item.label}</span>
                </a>
              ))}
            </nav>
          </div>

          <div class="side-card">
            <h3>Zones desservies</h3>
            <p class="side-copy">
              Ce service est offert à partir de Gatineau et peut aussi inclure Ottawa et Québec.
            </p>
            <div class="service-area-side-list">
              {serviceAreas.map((area) => (
                <article class="service-area-side-card">
                  <h4>{area}</h4>
                  <p>Accompagnement offert pour les demandes locales à {area} et dans les environs.</p>
                </article>
              ))}
            </div>
          </div>
        </aside>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .local-hero {
    padding: 4.5rem 0 3.8rem;
    background:
      radial-gradient(circle at top left, rgba(242, 210, 27, 0.18), transparent 25%),
      linear-gradient(135deg, var(--brand-navy-dark) 0%, #1f476d 58%, #eef3f7 58%, #eef3f7 100%);
  }

  .eyebrow {
    display: inline-flex;
    margin-bottom: 1rem;
    padding: 0.45rem 0.85rem;
    border-radius: 999px;
    background: rgba(255,255,255,0.12);
    color: var(--brand-gold);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(280px, 0.85fr);
    gap: 2rem;
    align-items: center;
  }

  .local-hero h1 {
    color: white;
    margin-bottom: 0.75rem;
    font-size: 3rem;
  }

  .local-hero p:not(.eyebrow) {
    color: #e7edf4;
    max-width: 58ch;
    font-size: 1.06rem;
  }

  .hero-card {
    background: white;
    border-radius: 22px;
    padding: 1.5rem;
    box-shadow: 0 16px 30px rgba(18, 35, 54, 0.18);
  }

  .hero-card h2 {
    margin-bottom: 0.85rem;
  }

  .hero-card ul {
    columns: 2;
    gap: 1.5rem;
    padding-left: 1.2rem;
  }

  .local-body {
    padding: 4rem 0;
    background: #f4f6f8;
  }

  .local-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(280px, 0.75fr);
    gap: 1.5rem;
    align-items: start;
  }

  .local-main {
    display: grid;
    gap: 1.5rem;
  }

  .content-card,
  .side-card {
    background: white;
    border-radius: 22px;
    padding: 1.6rem;
    box-shadow: 0 18px 34px rgba(21, 38, 58, 0.08);
  }

  .content-card.alt {
    background: linear-gradient(180deg, #fff9e2 0%, #ffffff 100%);
    border: 1px solid rgba(242, 210, 27, 0.45);
  }

  .content-card h2 {
    margin-bottom: 0.9rem;
  }

  .content-card p,
  .content-card li {
    color: var(--brand-muted);
  }

  .content-card ul {
    display: grid;
    gap: 0.65rem;
    padding-left: 1.2rem;
  }

  .info-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
  }

  .info-card {
    background: rgba(18, 52, 86, 0.04);
    border-radius: 18px;
    padding: 1.15rem;
  }

  .info-card:nth-child(even) {
    background: linear-gradient(180deg, #fff9e2 0%, #ffffff 100%);
    border: 1px solid rgba(242, 210, 27, 0.38);
  }

  .info-card h3 {
    margin-bottom: 0.55rem;
  }

  .faq-list {
    display: grid;
    gap: 0.85rem;
  }

  .faq-item {
    background: rgba(18, 52, 86, 0.04);
    border-radius: 16px;
    padding: 0.15rem 1rem;
  }

  .faq-item summary {
    cursor: pointer;
    list-style: none;
    padding: 0.95rem 0;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item h3 {
    margin: 0;
    font-size: 1.05rem;
  }

  .accordion-content {
    padding: 0 0 1rem;
  }

  .local-side {
    position: sticky;
    top: 1.5rem;
  }

  .cta-card {
    background: var(--brand-navy);
    color: white;
    border-radius: 24px;
    padding: 1.6rem;
    box-shadow: 0 18px 34px rgba(21, 38, 58, 0.18);
  }

  .cta-card h2,
  .cta-card p {
    color: white;
  }

  .phone-button,
  .contact-link {
    display: inline-flex;
    justify-content: center;
    width: 100%;
    margin-top: 0.85rem;
    padding: 0.95rem 1.2rem;
    border-radius: 999px;
    font-weight: 800;
    text-decoration: none;
  }

  .phone-button {
    background: var(--brand-gold);
    color: var(--brand-navy-dark);
  }

  .contact-link {
    background: white;
    color: var(--brand-navy-dark);
  }

  .side-card h3 {
    margin-bottom: 1rem;
    color: var(--brand-navy);
  }

  .service-nav {
    display: grid;
    gap: 0.75rem;
  }

  .service-nav a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.9rem 1rem;
    border-radius: 16px;
    background: rgba(18, 52, 86, 0.04);
    font-weight: 700;
    color: var(--brand-navy);
    text-decoration: none;
  }

  .service-nav i {
    color: var(--brand-gold);
  }

  .side-copy {
    color: var(--brand-muted);
    margin-bottom: 1rem;
  }

  .service-area-side-list {
    display: grid;
    gap: 0.85rem;
  }

  .service-area-side-card {
    padding: 1rem;
    border-radius: 16px;
    background: rgba(18, 52, 86, 0.04);
  }

  .service-area-side-card h4 {
    margin-bottom: 0.35rem;
    color: var(--brand-navy);
  }

  .service-area-side-card p {
    margin: 0;
    color: var(--brand-muted);
  }

  @media (max-width: 900px) {
    .local-hero {
      background: linear-gradient(180deg, var(--brand-navy-dark) 0%, #1f476d 100%);
      padding: 3.6rem 0 3rem;
    }

    .hero-grid,
    .local-layout {
      grid-template-columns: 1fr;
    }

    .hero-card ul {
      columns: 1;
    }

    .local-side {
      position: static;
    }

    .local-hero h1 {
      font-size: 2.3rem;
    }
  }
</style>
