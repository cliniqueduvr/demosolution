---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import siteSettings from '../data/site-settings.json';
import { buildBreadcrumbSchema, buildFAQSchema } from '../lib/seo';

const serviceLinks = [
  { href: '/services/decontamination/', label: 'Décontamination', icon: 'fas fa-biohazard' },
  { href: '/services/moisissure/', label: 'Moisissures', icon: 'fas fa-shield-virus' },
  { href: '/services/enlevement-vermiculite/', label: 'Vermiculite', icon: 'fas fa-exclamation-triangle' },
  { href: '/services/echantillonnage/', label: 'Échantillonnage', icon: 'fas fa-microscope' }
];

const nearbyAreas = [
  'Gatineau',
  'Hull',
  'Aylmer',
  'Buckingham',
  'Masson-Angers',
  'Chelsea',
  'Cantley',
  'Val-des-Monts',
  'L’Ange-Gardien',
  'La Pêche'
];

const faqs = [
  {
    question: "Travaillez-vous dans tout l’Outaouais?",
    answer:
      "Nous couvrons Gatineau et plusieurs municipalités de l’Outaouais selon la portée du projet, l’urgence et le type d’intervention à réaliser."
  },
  {
    question: "Quels services sont les plus demandés en Outaouais?",
    answer:
      "Les demandes fréquentes concernent la décontamination, la vermiculite, la moisissure, l’échantillonnage de matériaux, l’air amiante et les dossiers préparatoires avant rénovation ou démolition."
  },
  {
    question: "Pourquoi créer une page Outaouais en plus de Gatineau?",
    answer:
      "Parce que plusieurs demandes viennent de municipalités voisines qui ne cherchent pas toujours “Gatineau”, mais plutôt “Outaouais” comme zone plus large de service."
  }
];

const breadcrumbs = buildBreadcrumbSchema([
  { name: 'Accueil', path: '/' },
  { name: 'Outaouais' }
]);
---

<Layout
  title="Décontamination, vermiculite et échantillonnage en Outaouais"
  description="Services de décontamination, vermiculite, moisissure, inspection qualité de l’air et échantillonnage en Outaouais: Gatineau, Hull, Aylmer et secteurs voisins."
  canonicalPath="/outaouais/"
  frPath="/outaouais/"
  schemas={[breadcrumbs, buildFAQSchema(faqs)]}
>
  <Header />

  <main>
    <section class="local-hero">
      <div class="container hero-grid">
        <div>
          <p class="eyebrow">Secteur local</p>
          <h1>Décontamination, vermiculite et échantillonnage en Outaouais</h1>
          <p>
            Demo Solution accompagne les projets de <strong>décontamination</strong>,
            d’<strong>enlèvement de vermiculite</strong>, de <strong>moisissure</strong>,
            d’<strong>inspection qualité de l’air</strong> et d’<strong>échantillonnage</strong>
            à Gatineau et dans plusieurs secteurs de l’Outaouais. L’idée est simple: offrir une
            réponse locale plus claire pour les clients qui cherchent une intervention dans la région,
            pas seulement dans la ville de Gatineau.
          </p>
        </div>
        <div class="hero-card">
          <h2>Secteurs couverts en Outaouais</h2>
          <ul>
            {nearbyAreas.map((area) => <li>{area}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <section class="local-body">
      <div class="container local-layout">
        <div class="local-main">
          <section class="content-card">
            <h2>Services les plus demandés dans la région</h2>
            <div class="info-grid">
              <article class="info-card">
                <h3>Décontamination</h3>
                <p>Amiante, vermiculite, matériaux à risque et préparation avant travaux dans des bâtiments résidentiels ou commerciaux.</p>
              </article>
              <article class="info-card">
                <h3>Inspection qualité de l’air</h3>
                <p>Air amiante, spores, moisissure ou contamination fongique lorsque le doute doit être clarifié avant, pendant ou après les travaux.</p>
              </article>
              <article class="info-card">
                <h3>Moisissure et humidité</h3>
                <p>Entretoit, sous-sol, cavités et zones touchées après infiltration, dégât d’eau ou problème de ventilation.</p>
              </article>
              <article class="info-card">
                <h3>Échantillonnage</h3>
                <p>Matériaux suspects, vermiculite, air amiante, spores ou autres vérifications utiles pour bien cadrer la suite du chantier.</p>
              </article>
            </div>
          </section>

          <section class="content-card alt">
            <h2>Pourquoi cette page t’aide à mieux concurrencer en Outaouais</h2>
            <ul>
              <li>Elle renforce une intention locale plus large que seulement “Gatineau”.</li>
              <li>Elle permet de mieux capter les recherches régionales liées à l’Outaouais.</li>
              <li>Elle aide à appuyer tes campagnes Google Ads et tes extensions locales.</li>
              <li>Elle crée une page de destination plus pertinente pour des clients qui ne se reconnaissent pas uniquement dans le nom d’une ville.</li>
            </ul>
          </section>

          <section class="content-card">
            <h2>Situations fréquentes dans les secteurs autour de Gatineau</h2>
            <div class="info-grid">
              <article class="info-card">
                <h3>Entretoit avec vermiculite</h3>
                <p>Vérification avant isolation, rénovation ou ouverture d’un plafond dans un bâtiment plus ancien.</p>
              </article>
              <article class="info-card">
                <h3>Moisissure après infiltration</h3>
                <p>Sous-sol, entretoit, cavité murale ou matériau qui a mal séché après un dégât d’eau.</p>
              </article>
              <article class="info-card">
                <h3>Air amiante et spores</h3>
                <p>Lecture plus poussée avant, pendant ou après des travaux lorsqu’un doute persiste sur la qualité de l’air.</p>
              </article>
              <article class="info-card">
                <h3>Préparation avant démolition</h3>
                <p>Repérage de matériaux suspects et cadrage de la bonne séquence avant de démarrer un chantier.</p>
              </article>
            </div>
          </section>

          <section class="content-card faq-section">
            <h2>Questions fréquentes sur l’Outaouais</h2>
            <div class="faq-list">
              {faqs.map((item) => (
                <details class="faq-item">
                  <summary>
                    <h3>{item.question}</h3>
                  </summary>
                  <div class="accordion-content">
                    <p>{item.answer}</p>
                  </div>
                </details>
              ))}
            </div>
          </section>
        </div>

        <aside class="local-side">
          <div class="cta-card">
            <h2>Projet en Outaouais?</h2>
            <p>
              Si vous cherchez une intervention locale dans la région de Gatineau et des secteurs
              voisins, nous pouvons vous orienter vers la bonne suite rapidement.
            </p>
            <a class="phone-button" href={`tel:${siteSettings.phone.href}`}>{siteSettings.phone.display}</a>
            <a class="contact-link" href="/contact/">Demander une soumission</a>
          </div>

          <div class="side-card">
            <h3>Autres services</h3>
            <nav class="service-nav" aria-label="Autres services">
              {serviceLinks.map((item) => (
                <a href={item.href}>
                  <i class={item.icon}></i>
                  <span>{item.label}</span>
                </a>
              ))}
            </nav>
          </div>

          <div class="side-card">
            <h3>Zones desservies</h3>
            <p class="side-copy">
              Cette page couvre Gatineau et une zone plus large en Outaouais pour les demandes
              locales liées à l’amiante, la vermiculite, la moisissure et l’échantillonnage.
            </p>
            <div class="service-area-side-list">
              {nearbyAreas.slice(0, 6).map((area) => (
                <article class="service-area-side-card">
                  <h4>{area}</h4>
                  <p>Accompagnement offert pour les projets situés à {area} et dans les environs.</p>
                </article>
              ))}
            </div>
          </div>
        </aside>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .local-hero {
    padding: 4.5rem 0 3.8rem;
    background:
      radial-gradient(circle at top left, rgba(242, 210, 27, 0.18), transparent 25%),
      linear-gradient(135deg, var(--brand-navy-dark) 0%, #1f476d 58%, #eef3f7 58%, #eef3f7 100%);
  }

  .eyebrow {
    display: inline-flex;
    margin-bottom: 1rem;
    padding: 0.45rem 0.85rem;
    border-radius: 999px;
    background: rgba(255,255,255,0.12);
    color: var(--brand-gold);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(280px, 0.85fr);
    gap: 2rem;
    align-items: center;
  }

  .local-hero h1 {
    color: white;
    margin-bottom: 0.75rem;
    font-size: 3rem;
  }

  .local-hero p:not(.eyebrow) {
    color: #e7edf4;
    max-width: 58ch;
    font-size: 1.06rem;
  }

  .hero-card {
    background: white;
    border-radius: 22px;
    padding: 1.5rem;
    box-shadow: 0 16px 30px rgba(18, 35, 54, 0.18);
  }

  .hero-card h2 {
    margin-bottom: 0.85rem;
  }

  .hero-card ul {
    columns: 2;
    gap: 1.5rem;
    padding-left: 1.2rem;
  }

  .local-body {
    padding: 4rem 0;
    background: #f4f6f8;
  }

  .local-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(280px, 0.75fr);
    gap: 1.5rem;
    align-items: start;
  }

  .local-main,
  .local-side {
    display: grid;
    gap: 1.5rem;
  }

  .content-card,
  .side-card {
    background: white;
    border-radius: 22px;
    padding: 1.6rem;
    box-shadow: 0 18px 34px rgba(21, 38, 58, 0.08);
  }

  .content-card.alt {
    background: linear-gradient(180deg, #fff9e2 0%, #ffffff 100%);
    border: 1px solid rgba(242, 210, 27, 0.45);
  }

  .content-card h2 {
    margin-bottom: 0.9rem;
  }

  .content-card p,
  .content-card li {
    color: var(--brand-muted);
  }

  .content-card ul {
    display: grid;
    gap: 0.65rem;
    padding-left: 1.2rem;
  }

  .info-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
  }

  .info-card {
    background: rgba(18, 52, 86, 0.04);
    border-radius: 18px;
    padding: 1.15rem;
  }

  .info-card:nth-child(even) {
    background: linear-gradient(180deg, #fff9e2 0%, #ffffff 100%);
    border: 1px solid rgba(242, 210, 27, 0.38);
  }

  .info-card h3 {
    margin-bottom: 0.55rem;
  }

  .faq-list {
    display: grid;
    gap: 0.85rem;
  }

  .faq-item {
    background: rgba(18, 52, 86, 0.04);
    border-radius: 16px;
    padding: 0.15rem 1rem;
  }

  .faq-item summary {
    cursor: pointer;
    list-style: none;
    padding: 0.95rem 0;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item h3 {
    margin: 0;
    font-size: 1.05rem;
  }

  .accordion-content {
    padding: 0 0 1rem;
  }

  .local-side {
    position: sticky;
    top: 1.5rem;
  }

  .cta-card {
    background: var(--brand-navy);
    color: white;
    border-radius: 24px;
    padding: 1.6rem;
    box-shadow: 0 18px 34px rgba(21, 38, 58, 0.18);
  }

  .cta-card h2,
  .cta-card p {
    color: white;
  }

  .phone-button,
  .contact-link {
    display: inline-flex;
    justify-content: center;
    width: 100%;
    margin-top: 0.85rem;
    padding: 0.95rem 1.2rem;
    border-radius: 999px;
    font-weight: 800;
    text-decoration: none;
  }

  .phone-button {
    background: var(--brand-gold);
    color: var(--brand-navy-dark);
  }

  .contact-link {
    background: white;
    color: var(--brand-navy-dark);
  }

  .side-card h3 {
    margin-bottom: 1rem;
    color: var(--brand-navy);
  }

  .service-nav {
    display: grid;
    gap: 0.75rem;
  }

  .service-nav a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.9rem 1rem;
    border-radius: 16px;
    background: rgba(18, 52, 86, 0.04);
    font-weight: 700;
    color: var(--brand-navy);
    text-decoration: none;
  }

  .service-nav i {
    color: var(--brand-gold);
  }

  .side-copy {
    color: var(--brand-muted);
    margin-bottom: 1rem;
  }

  .service-area-side-list {
    display: grid;
    gap: 0.85rem;
  }

  .service-area-side-card {
    padding: 1rem;
    border-radius: 16px;
    background: rgba(18, 52, 86, 0.04);
  }

  .service-area-side-card h4 {
    margin-bottom: 0.35rem;
    color: var(--brand-navy);
  }

  .service-area-side-card p {
    margin: 0;
    color: var(--brand-muted);
  }

  @media (max-width: 900px) {
    .local-hero {
      background: linear-gradient(180deg, var(--brand-navy-dark) 0%, #1f476d 100%);
      padding: 3.6rem 0 3rem;
    }

    .hero-grid,
    .local-layout {
      grid-template-columns: 1fr;
    }

    .hero-card ul {
      columns: 1;
    }

    .local-side {
      position: static;
    }

    .local-hero h1 {
      font-size: 2.3rem;
    }

    .content-card,
    .side-card,
    .cta-card {
      border-radius: 18px;
      padding: 1.3rem;
    }
  }
</style>
