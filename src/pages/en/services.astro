---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import siteSettings from '../../data/site-settings.json';
import servicePagesData from '../../data/service-pages-en.json';
import type { ServicePage } from '../../data/service-page-types';
import { buildBreadcrumbSchema, buildFAQSchema } from '../../lib/seo';

const allowedServiceSlugs = ['decontamination', 'mould-removal', 'selective-demolition', 'vermiculite-removal', 'sampling'];
const servicePagesEn = servicePagesData.items as ServicePage[];
const visibleServicePagesEn = servicePagesEn.filter((service) => allowedServiceSlugs.includes(service.slug));
const simplifyCardCopy = (html: string) =>
  html
    .replace(/<a\b[^>]*>/g, '')
    .replace(/<\/a>/g, '');
const serviceAreas = [
  {
    name: 'Gatineau',
    href: '/gatineau/',
    body: 'Decontamination, asbestos, vermiculite, mould and sampling support in Gatineau and nearby sectors.'
  },
  {
    name: 'Ottawa',
    href: '/ottawa/',
    body: 'Asbestos, air sampling, vermiculite and project framing with Ottawa-specific context when needed.'
  }
];
const serviceFaqs = [
  {
    question: 'How do I choose the right service for my project?',
    answer: 'The right service depends mostly on the building, the materials involved and the sequence of work required. We can direct you toward decontamination, vermiculite removal, sampling, mould remediation or selective demolition based on the real need.'
  },
  {
    question: 'Do you only work in Gatineau?',
    answer: 'No. We serve Gatineau and Ottawa depending on project type, scope and logistics.'
  },
  {
    question: 'Can you handle more than one step of the project?',
    answer: 'Yes. Depending on the file, we can manage a coherent sequence that starts with sampling or decontamination and continues through selective demolition when required.'
  }
];
const quickSteps = [
  'Start with the service that best matches the material, symptom or risk you are dealing with.',
  'Open only the page that fits your immediate need: asbestos, vermiculite, mould, sampling or demolition.',
  'If the file is still unclear, contact us and we will help you decide whether sampling, decontamination or demolition is the right first step.'
];
const breadcrumbs = buildBreadcrumbSchema([
  { name: 'Home', path: '/en/' },
  { name: 'Services' }
]);
---

<Layout title="Demo Solution Services | Decontamination, asbestos, vermiculite, mould and sampling" description="Decontamination, asbestos-related work, vermiculite removal, sampling, mould remediation and selective demolition in Gatineau and Ottawa." lang="en-CA" canonicalPath="/en/services/" frPath="/services/" enPath="/en/services/" schemas={[breadcrumbs, buildFAQSchema(serviceFaqs)]}>
  <Header lang="en" />

  <main>
    <section class="page-header">
      <div class="container">
        <p class="eyebrow">For hazardous materials and building conditions</p>
        <h1>Our Services</h1>
        <p>Decontamination, asbestos-related work, vermiculite removal, mould remediation, sampling and selective demolition based on the real condition of the site.</p>
      </div>
    </section>

    <section class="services-content">
      <div class="container services-layout">
        <div class="services-main">
          <section class="services-grid-section">
            <div class="services-grid">
              {visibleServicePagesEn.map((service) => (
                <a class="service-card" href={`/en/services/${service.slug}/`}>
                  <p class="card-eyebrow">{service.eyebrow}</p>
                  <h2 class="card-title">{service.navLabel}</h2>
                  <p class="card-copy" set:html={simplifyCardCopy(service.lead)}></p>
                  <span>View service</span>
                </a>
              ))}
            </div>
          </section>

          <section class="planning-section">
            <div class="quick-steps-card">
              <h2>Where to start</h2>
              <div class="quick-steps-list">
                {quickSteps.map((item) => (
                  <p>{item}</p>
                ))}
              </div>
            </div>
          </section>

          <section class="seo-copy">
            <div class="seo-columns">
              <div class="info-card">
                <h2>A service adapted to your situation</h2>
                <p>Whether you are in the evaluation phase or preparing work on a contaminated or suspicious area, we can direct you toward the right first intervention based on the actual risk, material and next step on site.</p>
              </div>
              <div class="info-card">
                <h2>What we cover</h2>
                <p>Asbestos, vermiculite, mould, hazardous materials, asbestos-related air sampling, material sampling and selective demolition for residential and commercial files.</p>
              </div>
            </div>
          </section>

          <section class="service-areas-section">
            <div class="section-header">
              <h2>Areas served</h2>
              <p class="section-intro">We receive requests from Gatineau and Ottawa depending on the type of service and the scope of work.</p>
            </div>
            <div class="area-grid">
              {serviceAreas.map((area) => (
                <a class="area-card" href={area.href}>
                  <h3>{area.name}</h3>
                  <p>{area.body}</p>
                  <span>Contact us</span>
                </a>
              ))}
            </div>
          </section>

          <section class="service-faq-section">
            <h2>Frequently asked questions</h2>
            <div class="faq-list">
              {serviceFaqs.map((item) => (
                <details class="faq-item">
                  <summary>
                    <h3>{item.question}</h3>
                  </summary>
                  <div class="accordion-content">
                    <p>{item.answer}</p>
                  </div>
                </details>
              ))}
            </div>
          </section>
        </div>

        <aside class="services-side">
          <div class="support-card support-card-light">
            <div class="support-icon">
              <i class="fas fa-microscope"></i>
            </div>
            <h2>Need sampling before moving forward?</h2>
            <p>We can help you validate suspicious materials, choose the right sampling approach, and decide on the next useful step for your property.</p>
            <a class="support-link" href="/en/contact/">Talk to us about sampling</a>
          </div>

          <div class="support-card support-card-dark">
            <h2>Need a quick opinion?</h2>
            <p>We can point you toward the right intervention based on the actual condition of the property.</p>
            <a class="support-button" href={`tel:${siteSettings.phone.href}`}>{siteSettings.phone.display}</a>
            <a class="support-button secondary" href="/en/contact/">Request a quote</a>
          </div>
        </aside>
      </div>
    </section>

  </main>

  <Footer lang="en" />
</Layout>

<style>
  .page-header {
    background:
      radial-gradient(circle at top left, rgba(242, 210, 27, 0.18), transparent 25%),
      linear-gradient(135deg, var(--brand-navy-dark) 0%, #1f476d 58%, #eef3f7 58%, #eef3f7 100%);
    color: white;
    padding: 4.5rem 0 3.8rem;
  }

  .eyebrow {
    display: inline-flex;
    margin-bottom: 1rem;
    padding: 0.45rem 0.85rem;
    border-radius: 999px;
    background: rgba(255,255,255,0.12);
    color: var(--brand-gold);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .page-header h1 {
    color: white;
    margin-bottom: 0.75rem;
    font-size: 3rem;
  }

  .page-header p:last-child {
    margin: 0;
    max-width: 55ch;
    font-size: 1.08rem;
    color: #e7edf4;
  }

  .services-content {
    padding: 4rem 0;
    background: #f3f5f8;
  }

  .services-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(280px, 0.75fr);
    gap: 2rem;
    align-items: start;
  }

  .services-main {
    display: grid;
    gap: 2rem;
  }

  .services-side {
    position: sticky;
    top: 7rem;
    align-self: start;
    display: grid;
    gap: 1.5rem;
  }

  .services-grid-section,
  .planning-section,
  .service-areas-section,
  .service-faq-section {
    padding: 0;
  }

  .section-intro {
    max-width: 62ch;
    color: var(--brand-muted);
    margin: 0.75rem 0 0;
  }

  .seo-columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem;
  }

  .info-card {
    padding: 1.75rem;
    border-radius: 24px;
    background: white;
    box-shadow: 0 18px 34px rgba(21, 38, 58, 0.08);
  }

  .seo-columns p {
    margin-top: 0.75rem;
    color: var(--brand-muted);
  }

  .quick-steps-card,
  .support-card {
    display: grid;
    gap: 1rem;
    padding: 1.75rem;
    border-radius: 22px;
    background: white;
    box-shadow: 0 18px 34px rgba(21, 38, 58, 0.08);
  }

  .support-card {
    width: 100%;
    box-sizing: border-box;
    margin-left: 0;
  }

  .support-card-light {
    margin-left: 0;
    padding: 2rem 1.75rem;
    gap: 0.9rem;
    background:
      radial-gradient(circle at top left, rgba(242, 210, 27, 0.14), transparent 32%),
      linear-gradient(180deg, #ffffff 0%, #f8fbfd 100%);
    border: 1px solid rgba(31, 58, 95, 0.1);
    border-radius: 28px;
    box-shadow: 0 14px 30px rgba(21, 38, 58, 0.08);
  }

  .quick-steps-card {
    max-width: none;
  }

  .support-card-light h2,
  .support-card-dark h2 {
    margin: 0 0 0.2rem;
    color: var(--brand-navy);
    font-size: clamp(2rem, 3vw, 2.35rem);
    line-height: 1.02;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .support-card-light h2 {
    max-width: 10ch;
  }

  .support-icon {
    width: 4rem;
    height: 4rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 18px;
    background: linear-gradient(135deg, var(--brand-green), #57af49);
    color: white;
    font-size: 1.5rem;
    margin-bottom: 0.2rem;
  }

  .support-card-light p {
    margin: 0;
    color: var(--brand-muted);
  }

  .support-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 48px;
    padding: 0.85rem 1rem;
    border-radius: 999px;
    background: var(--brand-navy);
    color: white;
    font-weight: 700;
    text-decoration: none;
  }

  .support-link:hover {
    text-decoration: none;
    background: var(--brand-navy-dark);
  }

  .support-card-dark {
    background: var(--brand-navy-dark);
    color: white;
  }

  .support-card-dark h2 {
    max-width: 10ch;
    color: white;
  }

  .support-card-dark p {
    margin: 0;
    color: #dbe4ee;
  }

  .support-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 48px;
    border-radius: 999px;
    background: var(--brand-gold);
    color: var(--brand-navy-dark);
    font-weight: 700;
    text-decoration: none;
  }

  .support-button:hover {
    text-decoration: none;
    background: #e2c417;
  }

  .support-button.secondary {
    padding: 0.55rem 1rem;
    border: 2px solid var(--brand-gold);
  }

  .quick-steps-list {
    display: grid;
    gap: 0.85rem;
  }

  .quick-steps-list p {
    margin: 0;
    color: var(--brand-muted);
  }

  .services-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  .service-card,
  .area-card {
    display: grid;
    gap: 0.85rem;
    padding: 1.5rem;
    border-radius: 22px;
    background: white;
    box-shadow: 0 18px 34px rgba(21, 38, 58, 0.08);
    text-decoration: none;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .service-card {
    grid-template-rows: auto minmax(3.6rem, auto) 1fr auto;
    border: 2px solid transparent;
    transition: border-color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
  }

  .service-card:hover,
  .area-card:hover {
    text-decoration: none;
    transform: translateY(-4px);
    box-shadow: 0 24px 44px rgba(21, 38, 58, 0.14);
  }

  .service-card:hover {
    border-color: var(--brand-gold);
    box-shadow: 0 8px 16px rgba(0,0,0,0.1);
  }

  .card-eyebrow {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--brand-gold-dark);
    font-weight: 700;
  }

  .service-card h2,
  .card-title {
    font-size: 1.55rem;
    line-height: 1.1;
    color: var(--brand-navy);
    margin: 0;
  }

  .area-card h3,
  .faq-item h3 {
    margin: 0;
    color: var(--brand-navy);
    font-size: 1.08rem;
    line-height: 1.1;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .service-card p,
  .card-copy,
  .area-card p,
  .faq-item p {
    color: var(--brand-muted);
    margin: 0;
  }

  .service-card span,
  .area-card span {
    color: var(--brand-navy);
    font-weight: 700;
  }

  .area-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .section-header {
    margin-bottom: 1.5rem;
  }

  .faq-list {
    display: grid;
    gap: 1rem;
  }

  .faq-item {
    background: white;
    border: none;
    border-radius: 22px;
    padding: 1.35rem 1.5rem;
    box-shadow: 0 18px 34px rgba(21, 38, 58, 0.08);
  }

  .faq-item summary {
    list-style: none;
    cursor: pointer;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .accordion-content {
    display: grid;
    gap: 0.85rem;
    padding-top: 1rem;
  }

  @media (max-width: 900px) {
    .seo-columns,
    .area-grid {
      grid-template-columns: 1fr;
    }

    .services-layout {
      grid-template-columns: 1fr;
    }

    .services-side {
      position: static;
    }
  }

  @media (max-width: 768px) {
    .page-header {
      background: linear-gradient(180deg, var(--brand-navy-dark) 0%, #1f476d 100%);
      padding: 3.6rem 0 3rem;
    }

    .page-header h1 {
      font-size: 2.2rem;
    }

    .services-content {
      padding: 3rem 0;
    }
  }
</style>
