---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { buildLocalBusinessSchema, buildWebSiteSchema } from '../lib/seo';
import siteSettings from '../data/site-settings.json';
import homePage from '../data/home-page.json';
import projectsData from '../data/projects.json';

const isFormConfigured = Boolean(siteSettings.email?.trim());
const successUrl = '/merci.html?sent=1';
const formName = 'home-contact-fr-v2';
const schemas = [
  buildWebSiteSchema(),
  buildLocalBusinessSchema({
    telephone: siteSettings.phone.href,
    email: siteSettings.email,
    facebookUrl: siteSettings.facebookUrl,
    tiktokUrl: siteSettings.tiktokUrl,
    lang: 'fr-CA'
  })
];

const meta = {
  title: homePage.metaTitle,
  description: homePage.metaDescription
};

const heroLinks = [
  { label: 'Amiante', href: '/amiante/' },
  { label: 'Vermiculite', href: '/services/enlevement-vermiculite/' },
  { label: 'Moisissure', href: '/moisissure/' },
  { label: 'Mérule pleureuse', href: '/moisissure/' }
];
const heroHighlights = [
  'Soumission gratuite en 24h',
  'RBQ 5824-9764-01',
  'Assurance pollution',
  'Depuis 2013'
];
const heroActions = [
  { label: 'Obtenir ma soumission gratuite', href: '/soumission/', className: 'primary' },
  { label: 'Appeler maintenant', href: `tel:${siteSettings.phone.href}`, className: 'secondary' }
];
const proofGallery = (projectsData.items as Array<{ title: string; location: string; category: string; beforeImage: string; beforeAlt: string; }>)
  .slice(0, 4)
  .map((project) => ({
    title: project.title,
    location: project.location,
    category: project.category,
    image: project.beforeImage,
    alt: project.beforeAlt
  }));
const localSeoLinks = [
  {
    title: 'Amiante à Gatineau',
    href: '/amiante-gatineau/',
    body: 'Bâtiment ancien, matériau suspect, ouverture de mur ou plafond avant travaux.'
  },
  {
    title: 'Amiante à Ottawa',
    href: '/amiante-ottawa/',
    body: 'Dossier ontarien, air amiante et lecture Type 1, 2 ou 3 avant intervention.'
  },
  {
    title: 'Moisissure à Gatineau',
    href: '/moisissure-gatineau/',
    body: 'Infiltration, sous-sol humide, odeur persistante, spores et contamination fongique.'
  },
  {
    title: 'Vermiculite à Gatineau',
    href: '/vermiculite-gatineau/',
    body: 'Entretoit, zonolite, rénovation et doute sur un isolant à confirmer.'
  }
];
---

<Layout title={meta.title} description={meta.description} canonicalPath="/" frPath="/" enPath="/en/" schemas={schemas}>
  <Header />

  <main>
    <section class="hero">
      <div class="hero-content">
        <img class="hero-logo" src={siteSettings.brandImage} alt={homePage.hero.logoAlt} />
        <h1>{homePage.hero.title}</h1>
        <p class="hero-tagline" aria-label="Accès rapides">
          {heroLinks.map((item, index) => (
            <>
              <a href={item.href} class="hero-tagline-link">{item.label}</a>
              {index < heroLinks.length - 1 && <span class="hero-tagline-separator">|</span>}
            </>
          ))}
        </p>
        <p class="hero-lead">
          <strong>Décontamination d’amiante, vermiculite et moisissure</strong> à Gatineau, Ottawa et Québec,
          avec une approche <strong>rapide, sécuritaire et conforme</strong> avant rénovation, démolition ou réouverture d’une zone.
        </p>
        <div class="hero-actions">
          {heroActions.map((action) => (
            <a href={action.href} class:list={['hero-action', action.className]}>{action.label}</a>
          ))}
        </div>
        <div class="hero-highlights" aria-label="Points de confiance">
          {heroHighlights.map((item) => (
            <span class="hero-highlight">{item}</span>
          ))}
        </div>
      </div>
    </section>

    <!-- ABOUT & SERVICES INTRO -->
    <section class="intro-section">
      <div class="container intro-grid">
        <div class="intro-card">
          {homePage.introCard.icon && (
            <div class="card-icon">
              <i class={homePage.introCard.icon}></i>
            </div>
          )}
          <h2>{homePage.introCard.heading}</h2>
          <p set:html={homePage.introCard.body} />
        </div>
      </div>
    </section>

    <!-- SERVICES OVERVIEW -->
    <section class="services-overview">
      <div class="container">
        <h2>{homePage.servicesOverview.title}</h2>
        <div class="services-grid">
          {homePage.servicesOverview.items.map((item) => (
            <a href={item.href} class:list={['service-item', !item.icon && 'service-item--no-icon']}>
              {item.icon && <i class={item.icon}></i>}
              <span>{item.label}</span>
              {'subLabel' in item && item.subLabel && <small class="service-sub-label">{item.subLabel}</small>}
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="proof-section">
      <div class="container">
        <div class="section-heading">
          <h2>Preuve visuelle de terrain</h2>
          <p>Quelques exemples de chantiers réels, zones à ouvrir ou matériaux à traiter avant la suite des travaux.</p>
        </div>
        <div class="proof-grid">
          {proofGallery.map((project) => (
            <article class="proof-card">
              <img src={project.image} alt={project.alt} loading="lazy" />
              <div class="proof-card-body">
                <p class="proof-kicker">{project.category} • {project.location}</p>
                <h3>{project.title}</h3>
              </div>
            </article>
          ))}
        </div>
        <div class="proof-footer">
          <a href="/realisations/" class="proof-link">Voir l’album photo complet</a>
        </div>
      </div>
    </section>

    <section class="seo-copy">
      <div class="container seo-grid">
        {homePage.seoSections.map((section) => (
          <div>
            <h2>{section.heading}</h2>
            <p set:html={section.body} />
          </div>
        ))}
      </div>
    </section>

    <section class="local-seo-section">
      <div class="container">
        <div class="section-heading">
          <h2>Pages locales utiles avant travaux</h2>
          <p>Des pages plus ciblées pour répondre à des recherches précises à Gatineau et Ottawa.</p>
        </div>
        <div class="local-seo-grid">
          {localSeoLinks.map((item) => (
            <a href={item.href} class="local-seo-card">
              <h3>{item.title}</h3>
              <p>{item.body}</p>
              <span>Lire la page</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- CONTACT SECTION -->
    <section class="contact-section">
      <div class="container contact-grid">
        <div class="contact-form-wrapper">
          <h2>{homePage.contactForm.heading}</h2>
          {!isFormConfigured && (
            <p class="form-note">{homePage.contactForm.unconfiguredNote}</p>
          )}
          <form name={formName} action={isFormConfigured ? successUrl : undefined} method="POST" netlify data-netlify="true" netlify-honeypot="bot-field" data-netlify-form>
            <input type="hidden" name="form-name" value={formName} />
            <input type="hidden" name="bot-field" />
            <input type="hidden" name="Page" value="Accueil FR" />
            <label class="sr-only" for="home-name">{homePage.contactForm.namePlaceholder}</label>
            <input id="home-name" type="text" name="Nom complet" placeholder={homePage.contactForm.namePlaceholder} required />
            <label class="sr-only" for="home-email">{homePage.contactForm.emailPlaceholder}</label>
            <input id="home-email" type="email" name="Courriel" placeholder={homePage.contactForm.emailPlaceholder} required />
            <label class="sr-only" for="home-subject">{homePage.contactForm.subjectPlaceholder}</label>
            <input id="home-subject" type="text" name="Sujet" placeholder={homePage.contactForm.subjectPlaceholder} required />
            <label class="sr-only" for="home-message">{homePage.contactForm.messagePlaceholder}</label>
            <textarea id="home-message" name="Message" placeholder={homePage.contactForm.messagePlaceholder} rows="5" required></textarea>
            <button type="submit" disabled={!isFormConfigured}>{homePage.contactForm.submitLabel}</button>
          </form>
        </div>

        <div class="contact-info">
          <h3>{homePage.contactPanel.heading}</h3>
          <p><strong>Téléphone:</strong> <a href={`tel:${siteSettings.phone.href}`}>{siteSettings.phone.display}</a></p>
          <p><a href="/soumission/" class="contact-booking-link">{homePage.contactPanel.squareLabel}</a></p>
          <p><strong>Email:</strong> <a href={`mailto:${siteSettings.email}`}>{siteSettings.email}</a></p>
          <p><strong>Adresse:</strong> {siteSettings.address.fr}</p>
          <p><strong>Territoire desservi:</strong> {siteSettings.serviceArea.fr}</p>
          <p><strong>Assurance:</strong> <strong>Pollution</strong> et civile 2 millions | <strong>Depuis:</strong> {siteSettings.sinceYear}</p>
          <p class="cta-text">{homePage.contactPanel.ctaText}</p>
        </div>
      </div>
    </section>

    <section class="reviews-section">
      <div class="container">
        <h2>{homePage.reviews.heading}</h2>
        <div class="reviews-grid">
          {homePage.reviews.items.map((review) => (
            <article class="review-card">
              <p class="review-text">"{review.quote}"</p>
              <p class="review-author">{review.author}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  const homeForm = document.querySelector('form[data-netlify-form][name="home-contact-fr-v2"]');

  if (homeForm instanceof HTMLFormElement) {
    homeForm.addEventListener('submit', async (event) => {
      event.preventDefault();

      const submitter = homeForm.querySelector('button[type="submit"]');
      if (submitter instanceof HTMLButtonElement) {
        submitter.disabled = true;
      }

      try {
        const response = await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams(new FormData(homeForm) as any).toString()
        });

        if (!response.ok) {
          throw new Error(`Submission failed with ${response.status}`);
        }

        window.location.href = '/merci.html?sent=1';
      } catch (error) {
        console.error(error);
        homeForm.submit();
      } finally {
        if (submitter instanceof HTMLButtonElement) {
          submitter.disabled = false;
        }
      }
    });
  }
</script>

<style>
  .hero {
    min-height: 640px;
    display: flex;
    align-items: center;
    justify-content: center;
    background:
      linear-gradient(rgba(18, 34, 55, 0.72), rgba(18, 34, 55, 0.58)),
      radial-gradient(circle at top left, rgba(242, 210, 27, 0.18), transparent 28%),
      url('/hero-bg.jpg') center/cover no-repeat;
    text-align: center;
    color: white;
    padding: 5.5rem 1.5rem 4.5rem;
  }

  .hero-logo {
    width: min(760px, 88vw);
    height: auto;
    display: block;
    margin: 0 auto 2rem;
    border-radius: 24px;
    filter: drop-shadow(0 18px 35px rgba(0, 0, 0, 0.25));
  }

  .hero-tagline {
    font-size: 1.2rem;
    letter-spacing: 2px;
    margin-top: 1rem;
    line-height: 1.5;
  }

  .hero-tagline-link {
    color: white;
    text-decoration: none;
    transition: color 0.2s ease, transform 0.2s ease;
    display: inline-block;
  }

  .hero-tagline-link:hover {
    color: var(--brand-gold);
    text-decoration: none;
    transform: translateY(-1px);
  }

  .hero-tagline-separator {
    display: inline-block;
    margin: 0 0.45rem;
    color: rgba(255, 255, 255, 0.85);
  }

  .hero-lead {
    max-width: 48rem;
    margin: 1.2rem auto 0;
    color: #eef3f7;
    font-size: 1.08rem;
    line-height: 1.75;
  }

  .hero-actions {
    display: flex;
    justify-content: center;
    gap: 0.9rem;
    margin-top: 1.5rem;
    flex-wrap: wrap;
  }

  .hero-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.95rem 1.35rem;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 700;
    border: 2px solid transparent;
    transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease;
  }

  .hero-action.primary {
    background: var(--brand-gold);
    color: var(--brand-navy-dark);
    border-color: var(--brand-gold);
  }

  .hero-action.secondary {
    background: rgba(255, 255, 255, 0.12);
    color: white;
    border-color: rgba(255, 255, 255, 0.18);
  }

  .hero-action:hover {
    text-decoration: none;
    transform: translateY(-2px);
  }

  .hero-action.primary:hover {
    color: var(--brand-navy-dark);
    background: #e1c317;
    border-color: #e1c317;
  }

  .hero-action.secondary:hover {
    color: white;
    background: rgba(255, 255, 255, 0.2);
    border-color: rgba(255, 255, 255, 0.28);
  }

  .hero-highlights {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 1.35rem;
  }

  .hero-highlight {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 0.85rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.12);
    color: #eef3f7;
    font-size: 0.84rem;
    font-weight: 700;
    letter-spacing: 0.03em;
  }

  .hero-content h1 {
    color: white;
    max-width: 26ch;
    margin: 0 auto;
    line-height: 1.12;
  }

  .hero-content {
    width: min(980px, 100%);
  }

  .intro-section {
    padding: 4rem 0;
    background: white;
  }

  .intro-grid {
    display: flex;
    justify-content: center;
  }

  .intro-card {
    text-align: center;
    max-width: 720px;
  }

  .card-icon {
    font-size: 3rem;
    color: var(--brand-green);
    margin-bottom: 1rem;
  }

  .services-overview {
    padding: 4rem 0;
    background: var(--brand-surface);
  }

  .services-overview h2 {
    text-align: center;
  }

  .seo-copy {
    padding: 4rem 0;
    background: white;
  }

  .proof-section,
  .local-seo-section {
    padding: 4rem 0;
    background: white;
  }

  .proof-section {
    background: #f4f6f8;
  }

  .section-heading {
    margin-bottom: 1.6rem;
  }

  .section-heading p {
    margin-top: 0.6rem;
    color: var(--brand-muted);
    max-width: 58ch;
  }

  .proof-grid,
  .local-seo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.25rem;
  }

  .proof-card,
  .local-seo-card {
    background: white;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 16px 30px rgba(21, 38, 58, 0.08);
    text-decoration: none;
    color: inherit;
  }

  .proof-card img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
  }

  .proof-card-body,
  .local-seo-card {
    padding: 1.1rem 1.15rem 1.2rem;
  }

  .proof-kicker {
    margin: 0 0 0.45rem;
    color: var(--brand-green);
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .proof-card h3,
  .local-seo-card h3 {
    margin-bottom: 0.4rem;
  }

  .local-seo-card {
    display: block;
    border: 1px solid rgba(242, 210, 27, 0.35);
    background: linear-gradient(180deg, #fff9e8 0%, #ffffff 100%);
  }

  .local-seo-card p {
    color: var(--brand-muted);
  }

  .local-seo-card span,
  .proof-link {
    display: inline-flex;
    margin-top: 0.8rem;
    font-weight: 700;
    color: var(--brand-navy);
  }

  .proof-footer {
    margin-top: 1rem;
  }

  .proof-link:hover,
  .local-seo-card:hover span {
    color: var(--brand-gold-dark);
    text-decoration: none;
  }

  .seo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
  }

  .seo-grid p {
    margin-top: 0.75rem;
    color: var(--brand-muted);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 2rem;
    margin-top: 2rem;
  }

  .service-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 2rem;
    background: white;
    border-radius: 8px;
    transition: all 0.3s;
    border: 2px solid transparent;
  }

  .service-item:hover {
    border-color: var(--brand-gold);
    transform: translateY(-4px);
    box-shadow: 0 10px 20px rgba(242, 210, 27, 0.2);
  }

  .service-item i {
    font-size: 2.5rem;
    color: var(--brand-navy);
  }

  .service-item--no-icon {
    gap: 0;
  }

  .service-sub-label {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.78rem;
    line-height: 1.35;
    color: var(--brand-muted);
    text-align: center;
  }

  .contact-section {
    padding: 4rem 0;
    background: var(--brand-navy);
    color: white;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
  }

  .contact-form-wrapper h2 {
    color: white;
    margin-bottom: 1.5rem;
  }

  .contact-form-wrapper form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .form-note {
    margin-bottom: 1rem;
    color: #d9e6d1;
  }

  .contact-form-wrapper input,
  .contact-form-wrapper textarea {
    padding: 12px;
    border: none;
    border-radius: 4px;
    font-family: inherit;
  }

  .contact-info h3 {
    color: var(--brand-gold);
    margin-bottom: 1rem;
  }

  .contact-info p {
    margin-bottom: 0.75rem;
  }

  .contact-info a {
    color: white;
    font-weight: 700;
  }

  .contact-info a:hover {
    color: var(--brand-gold);
  }

  .contact-info .contact-booking-link {
    display: inline-block;
    background: var(--brand-gold);
    color: var(--brand-navy-dark);
    padding: 0.7rem 1.1rem;
    border-radius: 999px;
    border: 2px solid var(--brand-gold);
    text-decoration: none;
  }

  .contact-info .contact-booking-link:hover {
    color: var(--brand-navy-dark);
    background: #e1c317;
    border-color: #e1c317;
    text-decoration: none;
  }

  .cta-text {
    margin-top: 1.5rem;
    font-style: italic;
    color: #d9e6d1;
  }

  .reviews-section {
    padding: 4rem 0;
    background: #f4f6f8;
  }

  .reviews-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .review-card {
    background: white;
    border-radius: 18px;
    padding: 1.5rem;
    box-shadow: 0 14px 28px rgba(20, 36, 55, 0.08);
  }

  .review-text {
    color: var(--brand-ink);
    font-weight: 600;
  }

  .review-author {
    margin-top: 1rem;
    color: var(--brand-muted);
  }

  @media (max-width: 768px) {
    .hero {
      min-height: 0;
      padding: 4.25rem 1rem 3.25rem;
      align-items: center;
    }

    .hero-logo {
      width: min(520px, 88vw);
      margin: 0 auto 1.35rem;
      border-radius: 18px;
    }

    .hero-content h1 {
      font-size: 1.82rem;
      max-width: 12ch;
    }

    .hero-tagline {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.35rem 0.5rem;
      font-size: 0.9rem;
      margin-top: 0.85rem;
      letter-spacing: 0.7px;
    }

    .hero-tagline-separator {
      display: none;
    }

    .hero-lead {
      font-size: 0.98rem;
      line-height: 1.65;
      margin-top: 1rem;
    }

    .hero-actions {
      gap: 0.7rem;
      margin-top: 1.2rem;
    }

    .hero-action {
      width: 100%;
      max-width: 320px;
    }

    .hero-highlights {
      gap: 0.45rem;
      margin-top: 1rem;
    }

    .hero-highlight {
      font-size: 0.74rem;
      padding: 0.42rem 0.7rem;
    }

    .intro-section,
    .services-overview,
    .seo-copy,
    .contact-section,
    .reviews-section,
    .proof-section,
    .local-seo-section {
      padding: 2.6rem 0;
    }

    .intro-card {
      max-width: none;
    }

    .card-icon {
      font-size: 2.35rem;
      margin-bottom: 0.8rem;
    }

    .services-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.75rem;
      margin-top: 1.4rem;
    }

    .service-item {
      padding: 1rem 0.75rem;
      min-height: 104px;
      border-radius: 14px;
    }

    .service-item i {
      font-size: 2rem;
    }


    .service-item span {
      font-size: 0.95rem;
      text-align: center;
      line-height: 1.25;
    }

    .service-sub-label {
      font-size: 0.68rem;
      line-height: 1.3;
    }

    .seo-grid,
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 1.35rem;
    }

    .proof-grid,
    .local-seo-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .contact-form-wrapper h2,
    .reviews-section h2,
    .services-overview h2 {
      margin-bottom: 1rem;
    }

    .contact-form-wrapper form {
      gap: 0.85rem;
    }

    .contact-info {
      padding: 1.2rem;
      border-radius: 18px;
      background: rgba(255, 255, 255, 0.08);
    }

    .contact-info h3 {
      margin-bottom: 0.7rem;
    }

    .contact-form-wrapper input,
    .contact-form-wrapper textarea {
      padding: 0.85rem 0.9rem;
