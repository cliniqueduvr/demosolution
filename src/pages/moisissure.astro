---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import siteSettings from '../data/site-settings.json';
import { buildBreadcrumbSchema, buildFAQSchema } from '../lib/seo';

const serviceLinks = [
  { href: '/services/moisissure/', label: 'Moisissures', icon: 'fas fa-shield-virus' },
  { href: '/services/demolition-selective/', label: 'Démolition', icon: 'fas fa-house-damage' },
  { href: '/services/enlevement-vermiculite/', label: 'Vermiculite', icon: 'fas fa-exclamation-triangle' },
  { href: '/services/echantillonnage/', label: 'Échantillonnage', icon: 'fas fa-microscope' }
];

const serviceAreas = ['Gatineau', 'Ottawa', 'Québec'];
const serviceAreaHref = (area: string) => {
  if (area === 'Gatineau') return '/gatineau/';
  if (area === 'Ottawa') return '/ottawa/';
  if (area === 'Québec') return '/ville-de-quebec/';
  return '/contact/';
};

const faqs = [
  {
    question: 'La moisissure est-elle toujours dangereuse pour la santé?',
    answer:
      "La gravité dépend de l’ampleur du problème, du type de contamination, de l’exposition et de la sensibilité des occupants. Même une contamination limitée peut devenir problématique si elle reste active trop longtemps dans un espace fermé."
  },
  {
    question: 'Quels sont les signes les plus fréquents?',
    answer:
      "Les signes fréquents sont l’odeur de moisi, des taches sur les murs, plafonds ou sols, des matériaux humides, des auréoles, une peinture qui s’écaille ou un inconfort persistant dans une zone fermée."
  },
  {
    question: 'Peut-on avoir de la moisissure sans en voir?',
    answer:
      "Oui. Une contamination peut se développer derrière un mur, dans une cavité, dans un entretoit, derrière un revêtement ou dans un sous-sol mal ventilé sans être immédiatement visible."
  },
  {
    question: 'Pourquoi les maisons de cannabis posent-elles un risque particulier?',
    answer:
      "Une culture intérieure de cannabis augmente souvent fortement l’humidité et détériore la qualité de l’air. Cela peut générer une contamination fongique importante qui touche plusieurs surfaces et cavités en même temps."
  },
  {
    question: 'La mérule pleureuse est-elle seulement une moisissure noire?',
    answer:
      "Non. La mérule pleureuse est un champignon destructeur du bois qui demande une lecture plus poussée qu’une simple tache de moisissure. Elle doit être traitée rapidement pour éviter des dommages structuraux plus importants."
  }
];

const breadcrumbs = buildBreadcrumbSchema([
  { name: 'Accueil', path: '/' },
  { name: 'Moisissure' }
]);
---

<Layout
  title="Moisissure au Québec | Risques, signes, cannabis et mérule pleureuse"
  description="Guide ressource sur la moisissure au Québec: signes à surveiller, dangers pour la santé, entretoit, maison de cannabis, mérule pleureuse et quoi faire avant des travaux."
  canonicalPath="/moisissure/"
  frPath="/moisissure/"
  schemas={[breadcrumbs, buildFAQSchema(faqs)]}
>
  <Header />

  <main>
    <section class="resource-hero">
      <div class="container">
        <p class="eyebrow">Ressource</p>
        <h1>La moisissure au Québec: un problème de bâtiment, d’air intérieur et de santé</h1>
        <p>
          La moisissure n’est pas qu’une tache sur un mur. Elle peut révéler un problème
          d’<strong>humidité</strong>, d’<strong>infiltration</strong>, de
          <strong>ventilation</strong> ou de matériaux qui ont mal séché. Lorsqu’elle s’installe,
          elle peut affecter l’<strong>air ambiant</strong>, les matériaux du bâtiment et le confort
          des occupants, parfois sans être visible au premier regard.
        </p>
      </div>
    </section>

    <section class="resource-body">
      <div class="container resource-layout">
        <div class="resource-main">
          <section class="content-card">
            <h2>Les signes qui doivent vous mettre en alerte</h2>
            <ul>
              <li><strong>Odeur de moisi</strong>, terreuse ou persistante dans une pièce.</li>
              <li><strong>Taches</strong>, auréoles, noircissements ou décolorations sur murs, plafonds ou sols.</li>
              <li><strong>Matériaux humides</strong>, gondolés, friables ou qui se dégradent.</li>
              <li><strong>Inconfort respiratoire</strong>, irritation, allergies ou aggravation de l’asthme dans certaines zones.</li>
              <li><strong>Sous-sol, salle de bain, entretoit ou cavité</strong> qui ont mal séché après infiltration ou dégât d’eau.</li>
            </ul>
          </section>

          <section class="content-card alt warning-card">
            <h2>Pourquoi la moisissure est dangereuse</h2>
            <p>
              L’exposition à la moisissure se produit surtout par l’<strong>inhalation d’air
              contaminé</strong> et, dans certains cas, par le contact avec des matériaux touchés.
              Elle peut contribuer à des symptômes respiratoires, de l’irritation, des allergies,
              des maux de tête et à l’aggravation de certaines conditions préexistantes.
            </p>
            <p>
              Les nourrissons, les enfants, les personnes âgées, les femmes enceintes et les
              personnes immunosupprimées sont souvent plus sensibles à une mauvaise qualité de l’air
              intérieur.
            </p>
          </section>

          <section class="content-card">
            <h2>Les vrais risques reliés à une contamination par la moisissure</h2>
            <div class="info-grid">
              <article class="info-card">
                <h3>Air intérieur dégradé</h3>
                <p>Une zone contaminée peut affecter la qualité de l’air dans la pièce ou dans des espaces voisins.</p>
              </article>
              <article class="info-card">
                <h3>Propagation cachée</h3>
                <p>La moisissure peut progresser derrière les finis, dans des cavités ou sous des revêtements.</p>
              </article>
              <article class="info-card">
                <h3>Matériaux perdus</h3>
                <p>Gypse, isolants, bois, finis et autres matériaux peuvent devenir irrécupérables s’ils restent contaminés.</p>
              </article>
              <article class="info-card">
                <h3>Problème qui revient</h3>
                <p>Si la source d’humidité n’est pas réglée, la décontamination seule ne suffit pas à long terme.</p>
              </article>
            </div>
          </section>

          <section class="content-card alt">
            <h2>Test d’air et échantillonnage de moisissure</h2>
            <p>
              Il est possible qu’une contamination existe même si aucun signe visible n’apparaît
              clairement. Dans ces cas, l’<strong>échantillonnage</strong> ou un
              <strong>test d’air</strong> peut aider à documenter la situation, surtout avant des
              travaux, une transaction ou lorsqu’un doute persiste sur l’état réel de la zone.
            </p>
            <p>
              Le but n’est pas de multiplier les tests inutilement, mais de confirmer la bonne
              séquence: vérifier, contenir, retirer les matériaux touchés et corriger la cause.
            </p>
          </section>

          <section class="content-card">
            <h2>Moisissure dans l’entretoit</h2>
            <p>
              L’entretoit est l’un des endroits où l’on retrouve souvent de la moisissure à cause
              d’un <strong>manque de ventilation</strong>, d’un <strong>manque d’isolation</strong>,
              d’une <strong>infiltration</strong> ou d’un mauvais contrôle de l’humidité.
            </p>
            <p>
              Ce type de situation peut aussi compliquer une inspection préachat, une vente ou des
              travaux de rénovation si l’état du contreplaqué, de l’isolant ou de la ventilation
              n’est pas clair.
            </p>
          </section>

          <section class="content-card alt">
            <h2>Maison de cannabis et contamination fongique</h2>
            <p>
              Une maison ayant servi à la culture de cannabis peut présenter un niveau très élevé
              d’<strong>humidité</strong>, de <strong>condensation</strong> et de contamination
              fongique. Souvent, les dégâts ne se limitent pas à une seule pièce: murs, plafonds,
              cavités, systèmes de ventilation et air ambiant peuvent être touchés.
            </p>
            <p>
              Même lorsqu’on tente de camoufler le problème avec de la peinture ou des réparations
              de surface, la qualité de l’air peut rester mauvaise. Dans ce type de dossier, il faut
              souvent une lecture plus rigoureuse avant d’autoriser une réoccupation ou des travaux
              normaux.
            </p>
          </section>

          <section class="content-card">
            <h2>Mérule pleureuse: un cas plus grave à ne pas négliger</h2>
            <p>
              La <strong>mérule pleureuse</strong> n’est pas seulement une moisissure d’apparence
              inquiétante. C’est un champignon lignivore qui peut attaquer le bois et contribuer à
              des dommages plus sérieux dans la structure ou les éléments de charpente.
            </p>
            <ul>
              <li>Elle se développe dans des conditions d’humidité favorables et mal contrôlées.</li>
              <li>Elle exige souvent une intervention plus poussée qu’un simple nettoyage de surface.</li>
              <li>Plus elle reste active, plus les dommages au bois peuvent devenir coûteux.</li>
              <li>Elle doit être évaluée rapidement pour éviter de laisser progresser le problème.</li>
            </ul>
          </section>

          <section class="content-card alt">
            <h2>Quand il vaut mieux faire appel à un professionnel</h2>
            <ol>
              <li>Lorsque la zone touchée dépasse un simple nettoyage local et superficiel.</li>
              <li>Quand la source d’humidité n’est pas claire ou que la contamination revient.</li>
              <li>Lorsque la moisissure est présente dans un entretoit, derrière un mur ou dans une cavité.</li>
              <li>Quand un doute existe avant rénovation, démolition, vente ou achat d’un bâtiment.</li>
              <li>Lorsque le dossier implique cannabis, mérule pleureuse ou une contamination plus diffuse.</li>
            </ol>
          </section>

          <section class="content-card">
            <h2>Ce qu’il vaut mieux éviter</h2>
            <ul>
              <li>Peindre ou recouvrir une zone touchée sans avoir compris la cause.</li>
              <li>Ouvrir des matériaux humides ou suspects sans plan clair de confinement ou de retrait.</li>
              <li>Utiliser un nettoyage de surface comme solution finale alors que les cavités sont atteintes.</li>
              <li>Supposer que l’absence de taches visibles veut dire absence de contamination.</li>
              <li>Reporter l’intervention alors que l’humidité reste active ou que l’odeur persiste.</li>
            </ul>
          </section>

          <section class="content-card faq-section">
            <h2>Questions fréquentes sur la moisissure</h2>
            <div class="faq-list">
              {faqs.map((item) => (
                <details class="faq-item">
                  <summary>
                    <h3>{item.question}</h3>
                  </summary>
                  <div class="accordion-content">
                    <p>{item.answer}</p>
                  </div>
                </details>
              ))}
            </div>
          </section>
        </div>

        <aside class="resource-side">
          <div class="cta-card">
            <h2>Vous soupçonnez un problème de moisissure?</h2>
            <p>
              Avant de rénover, d’ouvrir un mur ou de tenter un nettoyage improvisé, il vaut mieux
              confirmer la situation et choisir la bonne prochaine étape.
            </p>
            <a class="phone-button" href={`tel:${siteSettings.phone.href}`}>{siteSettings.phone.display}</a>
            <a class="contact-link" href="/contact/">Demander une soumission</a>
          </div>

          <div class="side-card">
            <h3>Autres services</h3>
            <nav class="service-nav" aria-label="Autres services">
              {serviceLinks.map((item) => (
                <a href={item.href}>
                  <i class={item.icon}></i>
                  <span>{item.label}</span>
                </a>
              ))}
            </nav>
          </div>

          <div class="side-card">
            <h3>Zones desservies</h3>
            <p class="side-copy">
              Ce service est offert à partir de Gatineau et peut aussi inclure Ottawa et Québec.
            </p>
            <div class="service-area-side-list">
              {serviceAreas.map((area) => (
                <a href={serviceAreaHref(area)} class="service-area-side-card">
                  <h4>{area}</h4>
                  <p>Accompagnement offert pour les demandes liées à la moisissure à {area} et dans les environs.</p>
                </a>
              ))}
            </div>
          </div>
        </aside>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .resource-hero {
    padding: 4.5rem 0 3.8rem;
    background:
      radial-gradient(circle at top left, rgba(242, 210, 27, 0.18), transparent 25%),
      linear-gradient(135deg, var(--brand-navy-dark) 0%, #1f476d 58%, #eef3f7 58%, #eef3f7 100%);
    color: white;
  }

  .eyebrow {
    display: inline-flex;
    margin-bottom: 1rem;
    padding: 0.45rem 0.85rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.12);
    color: var(--brand-gold);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .resource-hero h1 {
    color: white;
    margin-bottom: 0.85rem;
    max-width: 19ch;
  }

  .resource-hero p:last-child {
    margin: 0;
    max-width: 64ch;
    font-size: 1.08rem;
    color: #e7edf4;
  }

  .resource-body {
    padding: 4rem 0;
    background: #f3f5f8;
  }

  .resource-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(280px, 0.75fr);
    gap: 2rem;
    align-items: start;
  }

  .resource-main,
  .resource-side {
    display: grid;
    gap: 1.5rem;
  }

  .content-card,
  .cta-card,
  .side-card {
    background: white;
    border-radius: 22px;
    padding: 1.75rem;
    box-shadow: 0 16px 34px rgba(24, 40, 61, 0.08);
  }

  .content-card.alt {
    background: linear-gradient(180deg, #f8fbf5 0%, #ffffff 100%);
  }

  .content-card h2,
  .cta-card h2 {
    margin-bottom: 1rem;
  }

  .content-card p,
  .content-card li,
  .section-copy,
  .accordion-content p {
    color: var(--brand-muted);
  }

  .content-card ul,
  .content-card ol {
    display: grid;
    gap: 0.85rem;
    padding-left: 1.15rem;
  }

  .content-card li::marker {
    color: var(--brand-green);
    font-weight: 700;
  }

  .info-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
  }

  .info-card {
    background: var(--brand-surface);
    border-radius: 18px;
    padding: 1.15rem;
  }


  .info-card h3 {
    margin-bottom: 0.45rem;
  }

  .warning-card {
    border: 1px solid rgba(242, 210, 27, 0.35);
    background: linear-gradient(180deg, #fffdf0 0%, #ffffff 100%);
  }

  .faq-list {
    display: grid;
    gap: 1rem;
  }

  .faq-item {
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(31, 58, 95, 0.08);
  }

  .faq-item:last-child {
    padding-bottom: 0;
    border-bottom: none;
  }

  .faq-item summary {
    list-style: none;
    cursor: pointer;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item h3 {
    margin: 0;
    font-size: 1rem;
  }

  .accordion-content {
    padding-top: 1rem;
  }

  .cta-card {
    position: sticky;
    top: 7rem;
    background: var(--brand-navy-dark);
    color: white;
  }

  .cta-card h2 {
    color: white;
  }

  .cta-card p {
    color: #dbe4ee;
  }

  .phone-button,
  .contact-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 48px;
    border-radius: 999px;
    font-weight: 700;
    text-decoration: none;
  }

  .phone-button {
    margin: 0.4rem 0 0.8rem;
    background: var(--brand-gold);
    color: var(--brand-navy-dark);
    border: 2px solid var(--brand-gold);
  }

  .phone-button:hover {
    text-decoration: none;
    background: #e1c317;
    border-color: #e1c317;
  }

  .contact-link {
    background: rgba(255, 255, 255, 0.12);
    color: white;
  }

  .contact-link:hover {
    text-decoration: none;
    background: rgba(255, 255, 255, 0.2);
  }

  .side-card h3 {
    margin-bottom: 1rem;
    color: var(--brand-navy);
  }

  .service-nav {
    display: grid;
    gap: 0.75rem;
  }

  .service-nav a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.9rem 1rem;
    border-radius: 16px;
    background: rgba(18, 52, 86, 0.04);
    font-weight: 700;
    color: var(--brand-navy);
    text-decoration: none;
  }

  .service-nav i {
    color: var(--brand-gold);
  }

  .side-copy {
    color: var(--brand-muted);
    margin-bottom: 1rem;
  }

  .service-area-side-list {
    display: grid;
    gap: 0.85rem;
  }

  .service-area-side-card {
    padding: 1rem;
    border-radius: 16px;
    background: rgba(18, 52, 86, 0.04);
    display: block;
    text-decoration: none;
  }

  .service-area-side-card h4 {
    margin-bottom: 0.35rem;
    color: var(--brand-navy);
  }

  .service-area-side-card p {
    margin: 0;
    color: var(--brand-muted);
  }

  .service-area-side-card:hover {
    text-decoration: none;
    background: #fff4b1;
  }

  @media (max-width: 920px) {
    .resource-layout {
      grid-template-columns: 1fr;
    }

    .cta-card {
      position: static;
    }
  }

  @media (max-width: 768px) {
    .resource-hero {
      background: linear-gradient(180deg, var(--brand-navy-dark) 0%, #1f476d 100%);
      padding: 3.6rem 0 3rem;
    }

    .resource-hero h1 {
      font-size: 2.2rem;
    }

    .content-card,
    .cta-card,
    .side-card {
      border-radius: 18px;
      padding: 1.3rem;
    }

    .info-grid,
    .resource-main,
    .resource-side,
    .faq-list {
      gap: 1rem;
    }
  }
</style>
