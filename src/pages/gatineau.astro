---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import siteSettings from '../data/site-settings.json';
import { buildBreadcrumbSchema, buildFAQSchema, buildLocalBusinessSchema, buildServiceSchema } from '../lib/seo';

const serviceLinks = [
  { href: '/services/moisissure/', label: 'Moisissures', icon: 'fas fa-shield-virus' },
  { href: '/services/demolition-selective/', label: 'Démolition', icon: 'fas fa-house-damage' },
  { href: '/services/enlevement-vermiculite/', label: 'Vermiculite', icon: 'fas fa-exclamation-triangle' },
  { href: '/services/echantillonnage/', label: 'Échantillonnage', icon: 'fas fa-microscope' }
];

const serviceAreas = ['Gatineau', 'Ottawa'];
const serviceAreaHref = (area: string) => {
  if (area === 'Gatineau') return '/gatineau/';
  if (area === 'Outaouais') return '/outaouais/';
  if (area === 'Ottawa') return '/ottawa/';
  if (area === 'Québec') return '/ville-de-quebec/';
  return '/contact/';
};

const nearbyAreas = [
  'Hull',
  'Aylmer',
  'Buckingham',
  'Masson-Angers',
  'Chelsea',
  'Cantley',
  'Val-des-Monts',
  'L’Ange-Gardien',
  'Pontiac',
  'La Pêche'
];

const commonSituations = [
  {
    title: 'Avant des rénovations',
    body: "Ouverture de murs, retrait de plafonds, vieux revêtements de sol, isolants suspects et matériaux qui datent d'avant les pratiques modernes."
  },
  {
    title: 'Après un dégât ou un sinistre',
    body: "Dégât d'eau, infiltration, contamination localisée, matériaux humides, poussières ou zone qui doit être sécurisée avant de poursuivre."
  },
  {
    title: 'Pour confirmer un doute',
    body: "Vermiculite dans l'entretoit, amiante dans un matériau ancien, moisissure visible, odeur persistante ou matériau qui semble détérioré."
  }
];

const localAdvantages = [
  {
    title: 'Basés à Gatineau',
    body: "Nous connaissons bien le secteur et pouvons intervenir rapidement à Gatineau ainsi que dans les municipalités voisines selon le dossier."
  },
  {
    title: 'Approche claire avant les travaux',
    body: "On commence par identifier le bon niveau d'intervention: échantillonnage, confinement, décontamination ciblée ou préparation avant démolition."
  },
  {
    title: 'Orientation locale utile',
    body: "Le but n'est pas d'alourdir votre chantier, mais de réduire le risque, éviter une erreur de séquence et vous orienter vers la bonne étape."
  }
];

const faqs = [
  {
    question: 'Intervenez-vous seulement à Gatineau même?',
    answer: "Non. Nous couvrons Gatineau et plusieurs secteurs périphériques comme Hull, Aylmer, Buckingham, Masson-Angers, Chelsea, Cantley, Val-des-Monts et d'autres municipalités voisines selon le projet."
  },
  {
    question: 'Quand faut-il faire un échantillonnage avant des travaux?',
    answer: "Dès qu'un matériau ancien, suspect ou non documenté doit être percé, coupé, retiré ou démoli. Cela permet de confirmer le risque avant d'ouvrir le chantier."
  },
  {
    question: 'Est-ce que vous faites seulement de l’amiante?',
    answer: "Non. Nous intervenons aussi pour la vermiculite, la moisissure, certaines situations de décontamination ciblée et la préparation sécuritaire avant travaux ou démolition."
  },
  {
    question: 'Pouvez-vous intervenir dans les secteurs autour de Gatineau?',
    answer: "Oui. Selon la portée du mandat, nous pouvons couvrir Gatineau et sa périphérie, y compris des projets vers Cantley, Chelsea, Val-des-Monts, L’Ange-Gardien, La Pêche et d'autres secteurs proches."
  }
];

const breadcrumbs = buildBreadcrumbSchema([
  { name: 'Accueil', path: '/' },
  { name: 'Gatineau' }
]);
const schemas = [
  breadcrumbs,
  buildFAQSchema(faqs),
  buildLocalBusinessSchema({
    telephone: siteSettings.phone.href,
    email: siteSettings.email,
    lang: 'fr-CA'
  }),
  buildServiceSchema({
    name: 'Décontamination et échantillonnage à Gatineau',
    serviceType: 'Décontamination, amiante, vermiculite, moisissure et échantillonnage à Gatineau',
    description: 'Services de décontamination, amiante, vermiculite, moisissure et échantillonnage à Gatineau et dans les secteurs voisins.',
    lang: 'fr-CA'
  })
];
---

<Layout
  title="Décontamination, amiante, vermiculite et échantillonnage à Gatineau"
  description="Services de décontamination, amiante, vermiculite, moisissures et échantillonnage à Gatineau et en périphérie: Hull, Aylmer, Buckingham, Chelsea, Cantley et secteurs voisins."
  canonicalPath="/gatineau/"
  frPath="/gatineau/"
  schemas={schemas}
>
  <Header />

  <main>
    <section class="local-hero">
      <div class="container hero-grid">
        <div>
          <p class="eyebrow">Secteur local</p>
          <h1>Décontamination, amiante, vermiculite et échantillonnage à Gatineau</h1>
          <p>
            Demo Solution accompagne les projets de <strong>décontamination</strong>,
            d’<strong><a href="/services/echantillonnage/">échantillonnage</a></strong>, d’<strong><a href="/services/enlevement-vermiculite/">enlèvement de vermiculite</a></strong>,
            de <strong>matériaux à risque</strong> et de <strong><a href="/services/moisissure/">moisissures</a></strong> à Gatineau
            et dans les secteurs voisins. L’objectif est simple: intervenir avec une méthode claire,
            réduire le risque avant les travaux et éviter les mauvaises décisions sur le chantier.
          </p>
        </div>
        <div class="hero-card">
          <h2>Zones couvertes autour de Gatineau</h2>
          <ul>
            {nearbyAreas.map((area) => <li>{area}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <section class="local-body">
      <div class="container local-layout">
        <div class="local-main">
          <section class="content-card">
            <h2>Quand ces services sont souvent nécessaires à Gatineau</h2>
            <div class="info-grid">
              {commonSituations.map((item) => (
                <article class="info-card">
                  <h3>{item.title}</h3>
                  <p>{item.body}</p>
                </article>
              ))}
            </div>
          </section>

          <section class="content-card alt">
            <h2>Matériaux et risques qu’on rencontre le plus souvent</h2>
            <ul>
              <li><strong>Vermiculite</strong> dans les entretoits ou certaines cavités plus anciennes.</li>
              <li><strong>Amiante</strong> dans des matériaux de finition, isolants, colles, plâtres, carreaux ou composés à joints.</li>
              <li><strong>Moisissures</strong> après infiltration, humidité chronique, sous-sol humide ou manque de ventilation.</li>
              <li><strong>Zones à sécuriser</strong> avant une rénovation, une démolition sélective ou la correction d’un sinistre.</li>
            </ul>
            <p>
              À Gatineau comme ailleurs, le vrai enjeu n’est pas seulement le matériau lui-même,
              mais <strong>le moment où il sera perturbé</strong>: perçage, coupe, retrait,
              démolition, assèchement, ouverture d’un plafond ou d’un mur. C’est pour cela qu’une
              lecture avec <strong><a href="/services/echantillonnage/">échantillonnage avant travaux</a></strong>
              ou une validation plus claire est souvent la bonne première étape.
            </p>
          </section>

          <section class="content-card">
            <h2>Pourquoi une page locale dédiée à Gatineau?</h2>
            <div class="info-grid">
              {localAdvantages.map((item) => (
                <article class="info-card">
                  <h3>{item.title}</h3>
                  <p>{item.body}</p>
                </article>
              ))}
            </div>
          </section>

          <section class="content-card alt">
            <h2>Ce qu’on peut prendre en charge dans le secteur</h2>
            <ul>
              <li>Échantillonnage avant rénovation, démolition ou ouverture de matériaux suspects.</li>
              <li>Évaluation de situations impliquant amiante, vermiculite ou contaminants visibles.</li>
              <li>Décontamination ciblée selon la nature du problème et la portée réelle des travaux.</li>
              <li>Préparation sécuritaire d’un chantier avant retrait, démolition ou reprise de travaux.</li>
              <li>Orientation vers la bonne séquence d’intervention pour éviter les erreurs coûteuses.</li>
            </ul>
          </section>

          <section class="content-card faq-section">
            <h2>Questions fréquentes pour Gatineau et la périphérie</h2>
            <div class="faq-list">
              {faqs.map((item) => (
                <details class="faq-item">
                  <summary>
                    <h3>{item.question}</h3>
                  </summary>
                  <div class="accordion-content">
                    <p>{item.answer}</p>
                  </div>
                </details>
              ))}
            </div>
          </section>
        </div>

        <aside class="local-side">
          <div class="cta-card">
            <h2>Projet à Gatineau ou autour?</h2>
            <p>
              Si vous devez ouvrir, retirer ou vérifier un matériau suspect avant des travaux,
              nous pouvons vous orienter rapidement vers la bonne suite.
            </p>
            <a class="phone-button" href={`tel:${siteSettings.phone.href}`}>{siteSettings.phone.display}</a>
            <a class="contact-link" href="/soumission/">Demander une soumission</a>
          </div>

          <div class="side-card">
            <h3>Autres services</h3>
            <nav class="service-nav" aria-label="Autres services">
              {serviceLinks.map((item) => (
                <a href={item.href}>
                  <i class={item.icon}></i>
                  <span>{item.label}</span>
                </a>
              ))}
            </nav>
          </div>

          <div class="side-card">
            <h3>Zones desservies</h3>
            <p class="side-copy">
              Cette page vise Gatineau d’abord, avec un lien utile vers Ottawa selon le projet.
            </p>
            <div class="service-area-side-list">
              {serviceAreas.map((area) => (
                <a href={serviceAreaHref(area)} class="service-area-side-card">
                  <h4>{area}</h4>
                  <p>Accompagnement offert pour les demandes locales à {area} et dans les environs.</p>
                </a>
              ))}
            </div>
          </div>
        </aside>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .local-hero {
    padding: 4.5rem 0 3.8rem;
    background:
      radial-gradient(circle at top left, rgba(242, 210, 27, 0.18), transparent 25%),
      linear-gradient(135deg, var(--brand-navy-dark) 0%, #1f476d 58%, #eef3f7 58%, #eef3f7 100%);
  }

  .eyebrow {
    display: inline-flex;
    margin-bottom: 1rem;
    padding: 0.45rem 0.85rem;
    border-radius: 999px;
    background: rgba(255,255,255,0.12);
    color: var(--brand-gold);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(280px, 0.85fr);
    gap: 2rem;
    align-items: center;
  }

  .local-hero h1 {
    color: white;
    margin-bottom: 0.75rem;
    font-size: 3rem;
  }

  .local-hero p:not(.eyebrow) {
    color: #e7edf4;
    max-width: 58ch;
    font-size: 1.06rem;
  }

  .hero-card {
    background: white;
    border-radius: 22px;
    padding: 1.5rem;
    box-shadow: 0 16px 30px rgba(18, 35, 54, 0.18);
  }

  .hero-card h2 {
    margin-bottom: 0.85rem;
  }

  .hero-card ul {
    columns: 2;
    gap: 1.5rem;
    padding-left: 1.2rem;
  }

  .local-body {
    padding: 4rem 0;
    background: #f4f6f8;
  }

  .local-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(280px, 0.75fr);
    gap: 1.5rem;
    align-items: start;
  }

  .local-main {
    display: grid;
    gap: 1.5rem;
  }

  .content-card,
  .side-card {
    background: white;
    border-radius: 22px;
    padding: 1.6rem;
    box-shadow: 0 18px 34px rgba(21, 38, 58, 0.08);
  }

  .content-card.alt {
    background: linear-gradient(180deg, #fff9e2 0%, #ffffff 100%);
    border: 1px solid rgba(242, 210, 27, 0.45);
  }

  .content-card h2 {
    margin-bottom: 0.9rem;
  }

  .content-card p,
  .content-card li {
    color: var(--brand-muted);
  }

  .content-card ul {
    display: grid;
    gap: 0.65rem;
    padding-left: 1.2rem;
  }

  .info-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
  }

  .info-card {
    background: rgba(18, 52, 86, 0.04);
    border-radius: 18px;
    padding: 1.15rem;
  }


  .info-card h3 {
    margin-bottom: 0.55rem;
  }

  .faq-list {
    display: grid;
    gap: 0.85rem;
  }

  .faq-item {
    background: rgba(18, 52, 86, 0.04);
    border-radius: 16px;
    padding: 0.15rem 1rem;
  }

  .faq-item summary {
    cursor: pointer;
    list-style: none;
    padding: 0.95rem 0;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item h3 {
    margin: 0;
    font-size: 1.05rem;
  }

  .accordion-content {
    padding: 0 0 1rem;
  }

  .local-side {
    display: grid;
    gap: 1.5rem;
    position: sticky;
    top: 1.5rem;
  }

  .cta-card {
    background: var(--brand-navy);
    color: white;
    border-radius: 24px;
    padding: 1.6rem;
    box-shadow: 0 18px 34px rgba(21, 38, 58, 0.18);
  }

  .cta-card h2,
  .cta-card p {
    color: white;
  }

  .phone-button,
  .contact-link {
    display: inline-flex;
    justify-content: center;
    width: 100%;
    margin-top: 0.85rem;
    padding: 0.95rem 1.2rem;
    border-radius: 999px;
    font-weight: 800;
    text-decoration: none;
  }

  .phone-button {
    background: var(--brand-gold);
    color: var(--brand-navy-dark);
  }

  .contact-link {
    background: white;
    color: var(--brand-navy-dark);
  }

  .side-card h3 {
    margin-bottom: 1rem;
    color: var(--brand-navy);
  }

  .service-nav {
    display: grid;
    gap: 0.75rem;
  }

  .service-nav a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.9rem 1rem;
    border-radius: 16px;
    background: rgba(18, 52, 86, 0.04);
    font-weight: 700;
    color: var(--brand-navy);
    text-decoration: none;
  }

  .service-nav i {
    color: var(--brand-gold);
  }

  .side-copy {
    color: var(--brand-muted);
    margin-bottom: 1rem;
  }

  .service-area-side-list {
    display: grid;
    gap: 0.85rem;
  }

  .service-area-side-card {
    padding: 1rem;
    border-radius: 16px;
    background: rgba(18, 52, 86, 0.04);
    display: block;
    text-decoration: none;
  }

  .service-area-side-card h4 {
    margin-bottom: 0.35rem;
    color: var(--brand-navy);
  }

  .service-area-side-card p {
    margin: 0;
    color: var(--brand-muted);
  }

  .service-area-side-card:hover {
    text-decoration: none;
    background: #fff4b1;
  }

  @media (max-width: 900px) {
    .local-hero {
      background: linear-gradient(180deg, var(--brand-navy-dark) 0%, #1f476d 100%);
      padding: 3.6rem 0 3rem;
    }

    .hero-grid,
    .local-layout {
      grid-template-columns: 1fr;
    }

    .hero-card ul {
      columns: 1;
    }

    .local-side {
      position: static;
    }

    .local-hero h1 {
      font-size: 2.3rem;
    }
  }
</style>
